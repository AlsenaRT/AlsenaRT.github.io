---
import BaseLayout from "./BaseLayout.astro";

import ProjectPreview
  from "../components/ProjectPreview.astro";

import type {
  Project,
} from "../data/projects";


interface Props {
  project: Project;

  nextProject?: Project;
}


const {
  project,
  nextProject,
} = Astro.props;
---

<BaseLayout
  title={project.title}
  description={project.description}
>

  <!-- =====================================================
       PROJECT HERO
       ===================================================== -->

  <section class="site-container">
    <div class="pt-10 md:pt-16">

      <!-- Back -->

      <a
        href="/work/"
        class="text-link font-mono text-[10px] uppercase tracking-[0.07em] text-muted"
      >
        ← All work
      </a>


      <!-- Title -->

      <div
        class="grid gap-10 pb-12 pt-16 md:grid-cols-12 md:pb-20 md:pt-24"
      >
        <div class="md:col-span-3">
          <p class="mono-label text-muted">
            {project.number}
            /
            {project.category}
          </p>
        </div>

        <div
          class="md:col-span-9"
        >
          <h1
            class="max-w-6xl text-[clamp(3.5rem,7.5vw,8.5rem)] leading-[0.88] font-medium tracking-[-0.065em]"
          >
            {project.title}
          </h1>
        </div>
      </div>


      <!-- Metadata -->

      <div
        class="grid gap-8 border-y border-line py-7 md:grid-cols-12 md:py-9"
      >
        <!-- Year -->

        <div class="md:col-span-2">
          <p class="mono-label text-muted">
            Year
          </p>

          <p class="text-[15px] leading-[1.65]">
            {project.year}
          </p>
        </div>


        <!-- Type -->

        <div class="md:col-span-3">
          <p class="mono-label text-muted">
            Focus
          </p>

          <p class="text-[15px] leading-[1.65]">
            {project.category}
          </p>
        </div>


        <!-- Disciplines -->

        <div class="text-[14px] leading-[1.6]">
          <p class="mono-label text-muted">
            Disciplines
          </p>

          <div
            class="mt-3 space-y-1 text-[13px]"
          >
            {
              project.disciplines.map(
                (discipline) => (
                  <p>
                    {discipline}
                  </p>
                )
              )
            }
          </div>
        </div>


        <!-- Overview -->

        <div
          class="md:col-span-4"
        >
          <p class="mono-label text-muted">
            Overview
          </p>

          <p
            class="max-w-[560px] text-[clamp(0.95rem,1vw,1.08rem)] leading-[1.75] text-muted"
          >
            {project.description}
          </p>
        </div>
      </div>

    </div>
  </section>


  <!-- =====================================================
       HERO VISUAL
       ===================================================== -->

  <section
    class="site-container py-10 md:py-16"
  >
    <div class="group">
      <ProjectPreview
        project={project}
        variant="hero"
      />
    </div>
  </section>


  <!-- =====================================================
       UNIQUE CASE STUDY CONTENT
       ===================================================== -->

  <slot />


  <!-- =====================================================
       NEXT PROJECT
       ===================================================== -->

  {
    nextProject && (
      <section
        class="site-container pt-20 md:pt-36"
      >
        <a
          href={`/work/${nextProject.slug}/`}
          class="group block border-t border-line py-12 md:py-20"
        >
          <div
            class="editorial-grid"
          >
            <div>
              <p
                class="mono-label text-muted"
              >
                Next project
              </p>
            </div>

            <div
              class="editorial-content"
            >
              <div
                class="flex items-start justify-between gap-8"
              >
                <div>
                  <p
                    class="mb-4 font-mono text-[10px] uppercase tracking-[0.07em] text-muted"
                  >
                    {nextProject.number}
                    /
                    {nextProject.category}
                  </p>

                  <h2
                    class="text-[clamp(2.5rem,5vw,6rem)] leading-[0.94] font-medium tracking-[-0.055em] transition-opacity duration-300 group-hover:opacity-50"
                  >
                    {nextProject.title}
                  </h2>
                </div>

                <span
                  class="mt-2 text-2xl transition-transform duration-300 group-hover:translate-x-2 group-hover:-translate-y-2 md:text-4xl"
                  aria-hidden="true"
                >
                  ↗
                </span>
              </div>
            </div>
          </div>
        </a>
      </section>
    )
  }

</BaseLayout>