---
import BaseLayout
  from "./BaseLayout.astro";

import type {
  Project,
} from "../data/projects";


interface Props {
  project: Project;
  nextProject?: Project;
}


const {
  project,
  nextProject,
} = Astro.props;
---

<BaseLayout
  title={project.title}
  description={project.description}
>
  <!-- =====================================================
       PROJECT UTILITY BAR
       The case study itself now owns its hero.
       ===================================================== -->

  <div
    class="site-container pt-6 md:pt-8"
  >
    <div
      class="flex items-center justify-between gap-6 border-b border-ink pb-4 text-[10px] uppercase tracking-[0.08em] text-muted md:text-[11px]"
    >
      <a
        href="/work/"
        class="transition-opacity duration-200 hover:opacity-50"
      >
        ← Selected work
      </a>

      <p>
        {project.number} / Case study
      </p>
    </div>
  </div>


  <!-- =====================================================
       PROJECT-SPECIFIC CONTENT
       ===================================================== -->

  <slot />


  <!-- =====================================================
       NEXT PROJECT
       ===================================================== -->

  {
    nextProject && (
      <section
        class="site-container pt-24 md:pt-40"
      >
        <a
          href={`/work/${nextProject.slug}/`}
          class="group block border-t border-ink py-10 md:py-16"
        >
          <div
            class="grid gap-8 md:grid-cols-12"
          >
            <div
              class="md:col-span-3"
            >
              <p
                class="rule-label text-muted"
              >
                Continue
              </p>
            </div>

            <div
              class="md:col-span-8 md:col-start-5"
            >
              <div
                class="flex items-start justify-between gap-8"
              >
                <div>
                  <p
                    class="mb-5 text-[10px] uppercase tracking-[0.08em] text-muted"
                  >
                    {nextProject.number}
                    {" · "}
                    {nextProject.category}
                  </p>

                  <h2
                    class="max-w-4xl text-[clamp(2.5rem,5vw,5.8rem)] leading-[0.95] font-medium tracking-[-0.05em] transition-opacity duration-300 group-hover:opacity-60"
                  >
                    {nextProject.title}
                  </h2>
                </div>

                <span
                  aria-hidden="true"
                  class="mt-1 shrink-0 text-2xl transition-transform duration-300 group-hover:translate-x-2 md:text-4xl"
                >
                  →
                </span>
              </div>
            </div>
          </div>
        </a>
      </section>
    )
  }
</BaseLayout>