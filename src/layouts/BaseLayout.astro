---
import "@fontsource-variable/manrope/wght.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";

import "../styles/global.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title?: string;

  description?: string;

  noindex?: boolean;
}


const {
  title = `${site.name} — ${site.role}`,

  description =
    "Portfolio of Alif Rafi Tulusena, a UI/UX Designer with a Computer Science background.",

  noindex = false,
} = Astro.props;


const pageTitle =
  title === `${site.name} — ${site.role}`
    ? title
    : `${title} — ${site.name}`;


const canonicalURL =
  new URL(
    Astro.url.pathname,
    site.url
  );

const isProd = 
  import.meta.env.PROD;
---

<!doctype html>

<html lang="en">
  <head>

    <meta charset="UTF-8" />

    <!--
      Security controls that can be expressed at document level on static hosting.

      Scripts are restricted to same-origin resources.
      Inline styles remain allowed because several visual components currently
      rely on inline style declarations.
    -->
   {
      isProd && (
        <meta
          http-equiv="Content-Security-Policy"
          content="default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; media-src 'self'; frame-src 'none'; worker-src 'self'; manifest-src 'self'; form-action 'none';"
        />
      )
    }

    <meta
      name="referrer"
      content="strict-origin-when-cross-origin"
    />

    <!-- Synchronous same-origin bootstrap: avoids requiring inline script. -->
    <script is:inline src="/security-init.js"></script>


    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />


    <title>
      {pageTitle}
    </title>


    <!-- Basic SEO -->

    <meta
      name="description"
      content={description}
    />

    <link
      rel="canonical"
      href={canonicalURL}
    />


    {
      noindex && (
        <meta
          name="robots"
          content="noindex,nofollow"
        />
      )
    }


    <!-- Open Graph -->

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:title"
      content={pageTitle}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonicalURL}
    />

    <meta
      property="og:site_name"
      content={site.name}
    />


    <!-- Twitter / generic social cards -->

    <meta
      name="twitter:card"
      content="summary"
    />

    <meta
      name="twitter:title"
      content={pageTitle}
    />

    <meta
      name="twitter:description"
      content={description}
    />


    <!-- Browser -->

    <meta
      name="theme-color"
      content="#f5f4f0"
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />


    <meta
      name="generator"
      content={Astro.generator}
    />

  </head>

    <body>

    <a
      href="#main-content"
      class="skip-link"
    >
      Skip to content
    </a>


    <Header />


    <main id="main-content">
      <slot />
    </main>


    <Footer />


    <script
      is:inline
      src="/reveal.js"
      defer
    ></script>

  </body>

</html>