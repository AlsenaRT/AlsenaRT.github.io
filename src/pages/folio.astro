---
import BaseLayout
  from "../layouts/BaseLayout.astro";

import {
  folio,
} from "../data/folio";
---

<BaseLayout
  title="Design Folio"
  description="Selected UI/UX portfolio spreads and design work by Alif Rafi Tulusena."
>
  <section
    class="site-container pt-12 md:pt-20"
  >
    <div
      class="grid gap-12 border-t border-ink pt-8 md:grid-cols-12"
    >
      <div
        class="md:col-span-3"
      >
        <p
          class="rule-label text-accent"
        >
          Design Folio
        </p>
      </div>

      <div
        class="md:col-span-8 md:col-start-5"
      >
        <h1
          class="max-w-[1050px] text-[clamp(3.5rem,7vw,8rem)] leading-[0.9] font-medium tracking-[-0.06em]"
        >
          The portfolio,
          <span
            class="editorial-serif"
          >
            as a publication.
          </span>
        </h1>

        <div
          class="mt-10 grid gap-8 md:grid-cols-2"
        >
          <p
            class="text-[15px] leading-[1.8] text-muted"
          >
            The website goes deeper into individual
            case studies. This folio keeps the work
            together as a single visual sequence —
            closer to how I originally designed it
            to be read.
          </p>

          <div
            class="md:text-right"
          >
            <a
              href={folio.pdf}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block border-b border-ink pb-1 text-[13px]"
            >
              Open complete PDF ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>


  <section
    class="site-container py-20 md:py-32"
  >
    <div
      class="grid gap-x-8 gap-y-16 md:grid-cols-2"
    >
      {
        folio.pages.map(
          (
            page,
            index
          ) => (
            <figure
              class:list={[
                index % 3 ===
                1
                  ? "md:mt-24"
                  : "",
              ]}
            >
              <div
                class="folio-sheet"
              >
                <img
                  src={
                    page.image
                  }
                  alt={
                    page.alt
                  }
                  loading={
                    index <
                    2
                      ? "eager"
                      : "lazy"
                  }
                />
              </div>

              <figcaption
                class="mt-4 flex items-center justify-between border-t border-line pt-3 text-[10px] uppercase tracking-[0.08em] text-muted"
              >
                <span>
                  Portfolio
                </span>

                <span>
                  {
                    page.number
                  }
                </span>
              </figcaption>
            </figure>
          )
        )
      }
    </div>
  </section>


  <section
    class="site-container pb-28 md:pb-44"
  >
    <div
      class="flex flex-col gap-8 border-t border-ink pt-8 md:flex-row md:items-end md:justify-between"
    >
      <h2
        class="max-w-4xl text-[clamp(2.5rem,5vw,5.5rem)] leading-[0.98] font-medium tracking-[-0.045em]"
      >
        Want the complete
        <span
          class="editorial-serif"
        >
          version?
        </span>
      </h2>

      <a
        href={folio.pdf}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 border-b border-ink pb-1 text-[13px]"
      >
        Open PDF ↗
      </a>
    </div>
  </section>
</BaseLayout>