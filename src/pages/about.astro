---
import BaseLayout
  from "../layouts/BaseLayout.astro";

import { site }
  from "../data/site";

const experience = [
  {
    period: "2026",
    role: "UI/UX Designer",
    organization: "FMIPA UGM",
    description:
      "Redesigning the faculty's main website and departmental websites while translating approved interfaces into WordPress.",
  },

  {
    period: "Jan — Feb 2026",
    role: "UI/UX Designer Intern",
    organization: "Datacakra",
    description:
      "Designed a Smart Building dashboard concept for a client-facing proposal and supported RekMed–SATUSEHAT requirements mapping through product survey, information architecture, and technical collaboration.",
  },

  {
    period: "2024 — 2025",
    role: "Full-stack Web Developer Intern",
    organization: "FMIPA UGM",
    description:
      "Designed and developed a student performance monitoring feature for the faculty's academic dashboard.",
  },
];

const designSkills = [
  "UI/UX Design",
  "Interface Design",
  "Responsive Web Design",
  "Wireframing",
  "Prototyping",
  "Figma",
];

const technicalSkills = [
  "HTML / CSS",
  "JavaScript",
  "PHP",
  "MySQL",
  "WordPress",
  "Git",
];
---

<BaseLayout
  title="About"
  description="About Alif Rafi Tulusena, a UI/UX Designer and Computer Science graduate based in Indonesia."
>

  <!-- =====================================================
       INTRO
       ===================================================== -->

  <section class="site-container">

    <div
      class="editorial-grid pb-20 pt-16 md:pb-32 md:pt-24"
    >

      <div>
        <p class="mono-label text-muted">
          About / 2026
        </p>
      </div>


      <div class="editorial-content">
        <h1
          class="max-w-[1100px] text-[clamp(3.6rem,7.2vw,8rem)] leading-[0.91] font-medium tracking-[-0.065em]"
        >
          Designer by focus.
          <span class="text-muted">
            Technologist by background.
          </span>
        </h1>
      </div>

    </div>

  </section>


  <!-- =====================================================
       PROFILE
       ===================================================== -->

  <section
    class="site-container py-20 md:py-28 lg:py-32"
  >
    <div
      class="editorial-grid border-t border-line pt-8"
      data-reveal
    >

      <div>
        <p class="mono-label text-muted">
          01 / Profile
        </p>
      </div>


      <div class="editorial-content">
        <p
          class="max-w-[980px] text-[clamp(1.15rem,1.45vw,1.45rem)] leading-[1.65] tracking-[-0.025em]"
        >
          I'm a Computer Science graduate from
          Universitas Gadjah Mada focused on
          designing clear and useful digital
          experiences.
        </p>


        <div
          class="mt-8 grid max-w-[980px] gap-6 text-[clamp(1rem,1.05vw,1.1rem)] leading-[1.8] text-muted lg:grid-cols-2 lg:gap-10"
        >
          <p>
            My work primarily sits within UI/UX
            and web design, where I enjoy turning
            requirements, content, and complex
            information into interfaces that feel
            structured and intentional.
          </p>

          <p>
            My development background also gives me
            an understanding of what happens beyond
            the design file. I've worked with
            frontend technologies, PHP, MySQL,
            WordPress, and web-based systems.
          </p>
        </div>


        <div
          class="mt-10 flex flex-wrap gap-x-7 gap-y-3"
        >
          <a
            href={site.resume}
            target="_blank"
            class="text-link text-[14px]"
          >
            View résumé ↗
          </a>

          <a
            href={site.links.linkedin}
            target="_blank"
            rel="noreferrer"
            class="text-link text-[14px]"
          >
            LinkedIn ↗
          </a>

          <a
            href={site.links.github}
            target="_blank"
            rel="noreferrer"
            class="text-link text-[14px]"
          >
            GitHub ↗
          </a>
        </div>

      </div>

    </div>
  </section>


  <!-- =====================================================
       EXPERIENCE
       ===================================================== -->

  <section
    class="site-container py-20 md:py-28 lg:py-32"
  >
    <div
      class="editorial-grid border-t border-line pt-8"
      data-reveal
    >

      <div>
        <p class="mono-label text-muted">
          02 / Experience
        </p>
      </div>


      <div class="editorial-content">

        {
          experience.map(
            (item) => (
              <article
                class="grid gap-5 border-b border-line py-10 first:pt-0 md:grid-cols-[170px_minmax(0,1fr)] md:gap-8"
              >

                <p
                  class="font-mono text-[11px] uppercase tracking-[0.06em] text-muted"
                >
                  {item.period}
                </p>


                <div>
                  <h2
                    class="text-[clamp(1.55rem,2vw,2rem)] leading-[1.12] font-medium tracking-[-0.035em]"
                  >
                    {item.role}
                  </h2>

                  <p
                    class="mt-2 text-[15px] leading-[1.6]"
                  >
                    {item.organization}
                  </p>

                  <p
                    class="mt-5 max-w-[760px] text-[clamp(1rem,1.05vw,1.08rem)] leading-[1.8] text-muted"
                  >
                    {item.description}
                  </p>
                </div>

              </article>
            )
          )
        }

      </div>

    </div>
  </section>


  <!-- =====================================================
       EDUCATION
       ===================================================== -->

  <section
    class="site-container py-20 md:py-28 lg:py-32"
  >
    <div
      class="editorial-grid border-t border-line pt-8"
      data-reveal
    >

      <div>
        <p class="mono-label text-muted">
          03 / Education
        </p>
      </div>


      <div class="editorial-content">
        <div
          class="grid gap-5 md:grid-cols-[170px_minmax(0,1fr)] md:gap-8"
        >

          <p
            class="font-mono text-[11px] uppercase tracking-[0.06em] text-muted"
          >
            2022 — 2026
          </p>


          <div>

            <!-- University -->

            <h2
              class="text-[clamp(2rem,2.8vw,2.8rem)] leading-[1.08] font-medium tracking-[-0.045em]"
            >
              Universitas Gadjah Mada
            </h2>


            <!-- Degree + GPA -->

            <div
              class="mt-3 flex flex-wrap items-baseline gap-x-6 gap-y-2"
            >

              <p
                class="text-[clamp(1rem,1.2vw,1.15rem)] leading-[1.6]"
              >
                Bachelor of Computer Science
              </p>


              <p
                class="font-mono text-[11px] uppercase tracking-[0.06em] text-muted"
              >
                GPA · 3.58 / 4.00
              </p>

            </div>


            <!-- Description -->

            <p
              class="mt-6 max-w-[900px] text-[clamp(1rem,1.05vw,1.08rem)] leading-[1.8] text-muted"
            >
              Computer Science education covering
              software development, databases, web
              technologies, and related technical
              foundations, complemented by practical
              experience in UI/UX design.
            </p>

          </div>
        </div>
      </div>

    </div>
  </section>


  <!-- =====================================================
       CAPABILITIES
       ===================================================== -->

  <section
    class="site-container py-20 md:py-28 lg:py-32"
  >
    <div
      class="editorial-grid border-t border-line pt-8"
      data-reveal
    >

      <div>
        <p class="mono-label text-muted">
          04 / Capabilities
        </p>
      </div>


      <div
        class="editorial-content grid gap-12 md:grid-cols-2 md:gap-16"
      >

        <!-- Design -->

        <div>
          <p
            class="mb-7 text-[15px] font-semibold"
          >
            Design
          </p>

          <div
            class="space-y-3"
          >
            {
              designSkills.map(
                (skill) => (
                  <p
                    class="border-b border-line pb-3 text-[15px] leading-[1.65] text-muted"
                  >
                    {skill}
                  </p>
                )
              )
            }
          </div>
        </div>


        <!-- Technical -->

        <div>
          <p
            class="mb-7 text-[15px] font-semibold"
          >
            Technical
          </p>

          <div
            class="space-y-3"
          >
            {
              technicalSkills.map(
                (skill) => (
                  <p
                    class="border-b border-line pb-3 text-[15px] leading-[1.65] text-muted"
                  >
                    {skill}
                  </p>
                )
              )
            }
          </div>
        </div>

      </div>

    </div>
  </section>

</BaseLayout>
