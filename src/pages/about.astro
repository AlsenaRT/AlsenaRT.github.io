---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About"
  description="About Alif Rafi Tulusena, UI/UX Designer and Computer Science graduate."
>
  <section class="site-container py-20 md:py-32">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-3">
        <p
          class="text-[12px] uppercase tracking-[0.12em] text-neutral-500"
        >
          About
        </p>
      </div>

      <div class="md:col-span-8 md:col-start-5">
        <h1
          class="text-[clamp(3.5rem,7vw,7rem)] leading-[0.92] font-medium tracking-[-0.06em]"
        >
          Designer by focus. Technologist by background.
        </h1>

        <div
          class="mt-16 max-w-2xl space-y-6 text-lg leading-relaxed text-neutral-600"
        >
          <p>
            I'm Alif, a Computer Science graduate focused
            on UI/UX design and digital product experiences.
          </p>

          <p>
            My technical background gives me an
            understanding of what happens beyond the design
            file, allowing me to think about both user
            experience and implementation.
          </p>

          <p>
            This page will eventually contain the complete
            story, experience, tools, and background.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>