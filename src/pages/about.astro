---
import BaseLayout
  from "../layouts/BaseLayout.astro";

import {
  profile,
} from "../data/profile";

import {
  site,
} from "../data/site";
---

<BaseLayout
  title="About"
  description="About Alif Rafi Tulusena — UI/UX Designer and Computer Science graduate."
>
  <!-- =====================================================
       INTRO
       ===================================================== -->

  <section
    class="site-container pt-12 md:pt-20"
  >
    <div
      class="grid gap-12 border-t border-ink pt-8 md:grid-cols-12"
    >
      <div
        class="md:col-span-3"
      >
        <p
          class="rule-label text-accent"
        >
          About
        </p>
      </div>


      <div
        class="md:col-span-8 md:col-start-5"
      >
        <h1
          class="max-w-[1050px] text-[clamp(3.6rem,7vw,7.8rem)] leading-[0.9] font-medium tracking-[-0.06em]"
        >
          Designer by focus.
          <br />
          Computer Scientist
          <span
            class="editorial-serif"
          >
            by training.
          </span>
        </h1>
      </div>
    </div>


    <div
      class="grid gap-10 py-16 md:grid-cols-12 md:py-24"
    >
      <div
        class="md:col-span-3"
      >
        <div
          class="border-t border-line pt-4"
        >
          <p
            class="text-[9px] uppercase tracking-[0.08em] text-muted"
          >
            Based in
          </p>

          <p
            class="mt-3 text-[13px]"
          >
            {site.location}
          </p>
        </div>
      </div>


      <div
        class="md:col-span-7 md:col-start-5"
      >
        <div
          class="space-y-7"
        >
          {
            profile.introduction.map(
              (paragraph) => (
                <p
                  class="max-w-3xl text-[clamp(1.15rem,1.8vw,1.6rem)] leading-[1.7] tracking-[-0.015em] text-muted"
                >
                  {paragraph}
                </p>
              )
            )
          }
        </div>
      </div>
    </div>
  </section>


  <!-- =====================================================
       HOW I WORK
       ===================================================== -->

  <section
    class="bg-ink text-paper"
  >
    <div
      class="site-container py-20 md:py-32"
    >
      <div
        class="grid gap-12 md:grid-cols-12"
      >
        <div
          class="md:col-span-3"
        >
          <p
            class="rule-label text-accent"
          >
            Where I fit
          </p>
        </div>


        <div
          class="md:col-span-8 md:col-start-5"
        >
          <h2
            class="max-w-[900px] text-[clamp(2.6rem,5vw,5.6rem)] leading-[0.98] font-medium tracking-[-0.05em]"
          >
            I am most useful when design
            has to understand what is
            happening underneath it.
          </h2>
        </div>
      </div>


      <div
        class="mt-16 border-t border-paper/25 md:mt-24"
      >
        {
          profile.workingAreas.map(
            (area) => (
              <article
                class="grid gap-6 border-b border-paper/15 py-9 md:grid-cols-12"
              >
                <p
                  class="text-[10px] text-accent md:col-span-1"
                >
                  {area.number}
                </p>

                <h3
                  class="text-[clamp(1.5rem,2.5vw,2.8rem)] leading-[1.05] font-medium tracking-[-0.035em] md:col-span-4"
                >
                  {area.title}
                </h3>

                <p
                  class="max-w-xl text-[13px] leading-[1.8] text-paper/55 md:col-span-6 md:col-start-7"
                >
                  {area.description}
                </p>
              </article>
            )
          )
        }
      </div>
    </div>
  </section>


  <!-- =====================================================
       EXPERIENCE
       ===================================================== -->

  <section
    class="site-container py-24 md:py-40"
  >
    <div
      class="grid gap-12 md:grid-cols-12"
    >
      <div
        class="md:col-span-3"
      >
        <p
          class="rule-label text-muted"
        >
          Experience
        </p>
      </div>


      <div
        class="md:col-span-8 md:col-start-5"
      >
        <div
          class="border-t border-ink"
        >
          {
            profile.experience.map(
              (
                experience,
                index
              ) => (
                <article
                  class="grid gap-6 border-b border-line py-9 md:grid-cols-12"
                >
                  <div
                    class="md:col-span-2"
                  >
                    <p
                      class="text-[10px] text-accent"
                    >
                      {String(
                        index + 1
                      ).padStart(
                        2,
                        "0"
                      )}
                    </p>

                    <p
                      class="mt-4 text-[10px] text-muted"
                    >
                      {experience.period}
                    </p>
                  </div>


                  <div
                    class="md:col-span-4"
                  >
                    <p
                      class="text-[10px] uppercase tracking-[0.08em] text-muted"
                    >
                      {experience.organization}
                    </p>

                    <h3
                      class="mt-4 text-[clamp(1.7rem,2.6vw,2.8rem)] leading-[1.04] font-medium tracking-[-0.035em]"
                    >
                      {experience.role}
                    </h3>
                  </div>


                  <div
                    class="md:col-span-6"
                  >
                    <p
                      class="max-w-xl text-[14px] leading-[1.8] text-muted"
                    >
                      {experience.description}
                    </p>
                  </div>
                </article>
              )
            )
          }
        </div>
      </div>
    </div>
  </section>


  <!-- =====================================================
       EDUCATION
       ===================================================== -->

  <section
    class="site-container pb-24 md:pb-40"
  >
    <div
      class="grid gap-12 border-t border-ink pt-10 md:grid-cols-12"
    >
      <div
        class="md:col-span-3"
      >
        <p
          class="rule-label text-muted"
        >
          Education
        </p>
      </div>


      <div
        class="md:col-span-8 md:col-start-5"
      >
        <p
          class="text-[10px] uppercase tracking-[0.08em] text-muted"
        >
          {profile.education.institution}
        </p>

        <h2
          class="mt-5 max-w-3xl text-[clamp(2.4rem,4.6vw,5rem)] leading-[1] font-medium tracking-[-0.045em]"
        >
          {profile.education.degree}
        </h2>
      </div>
    </div>
  </section>


  <!-- =====================================================
       TOOLS / CAPABILITIES
       ===================================================== -->

  <section
    class="bg-[#dedad0]"
  >
    <div
      class="site-container py-20 md:py-32"
    >
      <div
        class="grid gap-12 md:grid-cols-12"
      >
        <div
          class="md:col-span-3"
        >
          <p
            class="rule-label"
          >
            Working with
          </p>
        </div>


        <div
          class="md:col-span-8 md:col-start-5"
        >
          <h2
            class="max-w-[850px] text-[clamp(2.5rem,4.7vw,5.2rem)] leading-[1] font-medium tracking-[-0.045em]"
          >
            Tools are part of the work,
            not a proficiency scoreboard.
          </h2>
        </div>
      </div>


      <div
        class="mt-16 grid border-y border-ink md:grid-cols-2 md:mt-24"
      >
        <!-- Design -->

        <div
          class="border-b border-line py-8 md:border-r md:border-b-0 md:pr-10"
        >
          <p
            class="text-[10px] uppercase tracking-[0.08em] text-accent"
          >
            Design
          </p>

          <div
            class="mt-8 border-t border-ink/20"
          >
            {
              profile.design.map(
                (
                  tool,
                  index
                ) => (
                  <div
                    class="grid grid-cols-[36px_1fr] border-b border-ink/15 py-4"
                  >
                    <span
                      class="text-[9px] text-muted"
                    >
                      {String(
                        index + 1
                      ).padStart(
                        2,
                        "0"
                      )}
                    </span>

                    <span
                      class="text-[14px]"
                    >
                      {tool}
                    </span>
                  </div>
                )
              )
            }
          </div>
        </div>


        <!-- Development -->

        <div
          class="py-8 md:pl-10"
        >
          <p
            class="text-[10px] uppercase tracking-[0.08em] text-muted"
          >
            Development
          </p>

          <div
            class="mt-8 border-t border-ink/20"
          >
            {
              profile.development.map(
                (
                  tool,
                  index
                ) => (
                  <div
                    class="grid grid-cols-[36px_1fr] border-b border-ink/15 py-4"
                  >
                    <span
                      class="text-[9px] text-muted"
                    >
                      {String(
                        index + 1
                      ).padStart(
                        2,
                        "0"
                      )}
                    </span>

                    <span
                      class="text-[14px]"
                    >
                      {tool}
                    </span>
                  </div>
                )
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- =====================================================
       NEXT STEP
       ===================================================== -->

  <section
    class="site-container py-24 md:py-40"
  >
    <div
      class="grid gap-12 border-t border-ink pt-10 md:grid-cols-12"
    >
      <div
        class="md:col-span-3"
      >
        <p
          class="rule-label text-muted"
        >
          More
        </p>
      </div>


      <div
        class="md:col-span-8 md:col-start-5"
      >
        <p
          class="max-w-[900px] text-[clamp(2.4rem,4.5vw,5rem)] leading-[1.02] font-medium tracking-[-0.045em]"
        >
          The case studies show the work
          in more detail than a biography can.
        </p>


        <div
          class="mt-10 flex flex-wrap gap-x-8 gap-y-5 text-[13px]"
        >
          <a
            href="/work/"
            class="border-b border-ink pb-1"
          >
            View case studies →
          </a>

          <a
            href="/folio/"
            class="border-b border-ink pb-1"
          >
            Design folio →
          </a>

          <a
            href={site.resume}
            target="_blank"
            rel="noopener noreferrer"
            class="border-b border-ink pb-1"
          >
            Résumé ↗
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>