---
import BaseLayout
  from "../../layouts/BaseLayout.astro";

import ProjectCard
  from "../../components/ProjectCard.astro";

import {
  projects,
} from "../../data/projects";

import {
  otherWork,
} from "../../data/otherWork";
---

<BaseLayout
  title="Work"
  description="Selected UI/UX design, web development, and technical projects by Alif Rafi Tulusena."
>

  <!-- =====================================================
       HERO
       ===================================================== -->

  <section class="site-container">

    <div
      class="grid gap-12 pb-20 pt-16 md:grid-cols-12 md:pb-28 md:pt-24"
    >

      <div class="md:col-span-3">
        <p class="mono-label text-muted">
          Work / 2024—2026
        </p>
      </div>


      <div
        class="md:col-span-9"
      >
        <h1
          class="max-w-6xl text-[clamp(4.5rem,9vw,10rem)] leading-[0.86] font-medium tracking-[-0.07em]"
        >
          Selected
          <span class="text-muted">
            work.
          </span>
        </h1>
      </div>

    </div>


    <!-- Intro -->

    <div
      class="grid gap-8 border-y border-line py-7 md:grid-cols-12"
    >

      <div
        class="md:col-span-4 md:col-start-5"
      >
        <p
          class="text-[13px] leading-[1.7] text-muted"
        >
          A selection of projects across UI/UX
          design, web experiences, product
          interfaces, and technical implementation.
        </p>
      </div>


      <div
        class="md:col-span-3 md:col-start-10"
      >
        <p class="mono-label text-muted">
          Featured
        </p>

        <p
          class="mt-2 text-[13px]"
        >
          {projects.length} case studies
        </p>
      </div>

    </div>

  </section>


  <!-- =====================================================
       FEATURED PROJECTS
       ===================================================== -->

  <section
    class="site-container pt-20 md:pt-32"
  >

    <div
      class="grid gap-10 pb-12 md:grid-cols-12 md:pb-16"
      data-reveal
    >

      <div class="md:col-span-3">
        <p class="mono-label text-muted">
          01 / Case Studies
        </p>
      </div>


      <div
        class="md:col-span-7 md:col-start-5"
      >
        <h2
          class="section-title"
        >
          Projects where design,
          technology, or both played
          a meaningful role.
        </h2>
      </div>

    </div>


    <div>
      {
        projects.map(
          (project, index) => (
            <ProjectCard
              project={project}
              index={index}
            />
          )
        )
      }
    </div>

  </section>


  <!-- =====================================================
       OTHER WORK
       ===================================================== -->

  <section
    class="site-container py-28 md:py-44"
  >

    <div
      class="grid gap-12 border-t border-line pt-8 md:grid-cols-12"
      data-reveal
    >

      <div class="md:col-span-3">
        <p class="mono-label text-muted">
          02 / Other Work
        </p>
      </div>


      <div
        class="md:col-span-8 md:col-start-5"
      >
        {
          otherWork.map(
            (item) => (
              <article
                class="grid gap-5 border-b border-line py-8 first:pt-0 md:grid-cols-[90px_1fr]"
              >

                <!-- Year -->

                <p
                  class="font-mono text-[10px] text-muted"
                >
                  {item.year}
                </p>


                <!-- Main content -->

                <div>
                  <p
                    class="mb-2 font-mono text-[9px] uppercase tracking-[0.07em] text-muted"
                  >
                    {item.category}
                  </p>

                  <h2
                    class="text-2xl font-medium tracking-[-0.04em] md:text-3xl"
                  >
                    {item.title}
                  </h2>

                  <p
                    class="mt-5 max-w-xl text-[13px] leading-[1.75] text-muted"
                  >
                    {item.description}
                  </p>


                  <div
                    class="mt-6 flex flex-wrap gap-4"
                  >
                    {
                      item.tags.map(
                        (tag) => (
                          <span
                            class="font-mono text-[9px] uppercase tracking-[0.05em] text-muted"
                          >
                            {tag}
                          </span>
                        )
                      )
                    }
                  </div>
                </div>

              </article>
            )
          )
        }
      </div>

    </div>

  </section>

</BaseLayout>