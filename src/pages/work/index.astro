---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";

import { projects } from "../../data/projects";
---

<BaseLayout
  title="Work"
  description="Selected UI/UX design and development projects by Alif Rafi Tulusena."
>
  <section class="site-container py-20 md:py-32">
    <div
      class="mb-20 border-b border-neutral-200 pb-10 md:mb-28"
    >
      <p
        class="mb-8 text-[12px] uppercase tracking-[0.12em] text-neutral-500"
      >
        Selected Work
      </p>

      <h1
        class="max-w-5xl text-[clamp(4rem,9vw,9rem)] leading-[0.88] font-medium tracking-[-0.065em]"
      >
        Work
      </h1>
    </div>

    <div class="grid gap-20 md:gap-28">
      {
        projects.map((project) => (
          <ProjectCard project={project} />
        ))
      }
    </div>
  </section>
</BaseLayout>