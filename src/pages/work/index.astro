---
import BaseLayout
  from "../../layouts/BaseLayout.astro";

import WorkIndexItem
  from "../../components/WorkIndexItem.astro";

import {
  projects,
} from "../../data/projects";

import {
  otherWork,
} from "../../data/otherWork";

import {
  folio,
} from "../../data/folio";
---

<BaseLayout
  title="Work"
  description="Selected UI/UX design, product, and development work by Alif Rafi Tulusena."
>
  <!-- =====================================================
       PAGE INTRO
       ===================================================== -->

  <section
    class="site-container pt-12 md:pt-20"
  >
    <div
      class="grid gap-12 border-t border-ink pt-8 md:grid-cols-12"
    >
      <div
        class="md:col-span-3"
      >
        <p
          class="rule-label text-accent"
        >
          Selected Work
        </p>
      </div>

      <div
        class="md:col-span-8 md:col-start-5"
      >
        <h1
          class="max-w-[1050px] text-[clamp(3.8rem,7vw,8rem)] leading-[0.9] font-medium tracking-[-0.06em]"
        >
          Work across interfaces,
          systems, and
          <span
            class="editorial-serif"
          >
            implementation.
          </span>
        </h1>

        <p
          class="mt-10 max-w-2xl text-[15px] leading-[1.8] text-muted"
        >
          These projects cover different kinds of
          design problems — from restructuring a
          public-facing faculty website, to building
          an academic monitoring system, to working
          between product requirements and technical
          teams during an internship.
        </p>
      </div>
    </div>
  </section>


  <!-- =====================================================
       CASE STUDY INDEX
       ===================================================== -->

  <section
    class="site-container pt-20 md:pt-32"
  >
    <div
      class="mb-6 flex items-end justify-between"
    >
      <p
        class="text-[10px] uppercase tracking-[0.08em] text-muted"
      >
        Case studies
      </p>

      <p
        class="text-[10px] text-muted"
      >
        01—03
      </p>
    </div>

    <div
      class="border-b border-line"
    >
      {
        projects.map(
          (project) => (
            <WorkIndexItem
              project={project}
            />
          )
        )
      }
    </div>
  </section>


  <!-- =====================================================
       DESIGN FOLIO
       ===================================================== -->

  <section
    class="site-container py-24 md:py-40"
  >
    <div
      class="bg-ink px-6 py-10 text-paper sm:px-10 md:px-14 md:py-16 lg:px-20 lg:py-20"
    >
      <div
        class="grid gap-14 md:grid-cols-12"
      >
        <div
          class="md:col-span-3"
        >
          <p
            class="rule-label text-accent"
          >
            Design Folio
          </p>
        </div>

        <div
          class="md:col-span-8 md:col-start-5"
        >
          <h2
            class="max-w-[900px] text-[clamp(2.8rem,5.5vw,6.2rem)] leading-[0.95] font-medium tracking-[-0.05em]"
          >
            Selected design work,
            <span
              class="editorial-serif"
            >
              in publication form.
            </span>
          </h2>

          <p
            class="mt-10 max-w-xl text-[14px] leading-[1.8] text-paper/55"
          >
            A visual companion to the case studies,
            with more room for layouts, process,
            interface exploration, and mockups.
          </p>

          <div
            class="mt-8 flex flex-wrap gap-7 text-[13px]"
          >
            <a
              href="/folio/"
              class="border-b border-paper/40 pb-1"
            >
              Explore folio →
            </a>

            <a
              href={folio.pdf}
              target="_blank"
              rel="noopener noreferrer"
              class="border-b border-paper/25 pb-1 text-paper/55 transition-colors hover:text-paper"
            >
              Open PDF ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- =====================================================
       SUPPORTING WORK
       ===================================================== -->

  <section
    class="site-container pb-28 md:pb-44"
  >
    <div
      class="grid gap-12 border-t border-ink pt-8 md:grid-cols-12"
    >
      <div
        class="md:col-span-3"
      >
        <p
          class="rule-label text-muted"
        >
          Beyond case studies
        </p>
      </div>

      <div
        class="md:col-span-8 md:col-start-5"
      >
        <p
          class="mb-12 max-w-xl text-[14px] leading-[1.75] text-muted"
        >
          Smaller technical and testing work that
          adds context to my Computer Science
          background without pretending every
          project needs a full portfolio case study.
        </p>

        <div
          class="border-t border-line"
        >
          {
            otherWork.map(
              (
                work,
                index
              ) => (
                <article
                  class="grid gap-6 border-b border-line py-8 md:grid-cols-12"
                >
                  <div
                    class="md:col-span-2"
                  >
                    <p
                      class="text-[10px] text-accent"
                    >
                      {String(
                        index + 1
                      ).padStart(
                        2,
                        "0"
                      )}
                    </p>

                    <p
                      class="mt-3 text-[10px] text-muted"
                    >
                      {work.year}
                    </p>
                  </div>

                  <div
                    class="md:col-span-4"
                  >
                    <p
                      class="mb-2 text-[9px] uppercase tracking-[0.08em] text-muted"
                    >
                      {work.category}
                    </p>

                    <h3
                      class="text-[clamp(1.6rem,2.5vw,2.7rem)] leading-[1.05] font-medium tracking-[-0.035em]"
                    >
                      {work.title}
                    </h3>
                  </div>

                  <div
                    class="md:col-span-6"
                  >
                    <p
                      class="max-w-xl text-[13px] leading-[1.75] text-muted"
                    >
                      {work.description}
                    </p>

                    <div
                      class="mt-5 flex flex-wrap gap-4"
                    >
                      {
                        work.meta.map(
                          (item) => (
                            <span
                              class="text-[9px] uppercase tracking-[0.07em] text-muted"
                            >
                              {item}
                            </span>
                          )
                        )
                      }
                    </div>
                  </div>
                </article>
              )
            )
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>