---
import BaseLayout
  from "../../layouts/BaseLayout.astro";

import ProjectCard
  from "../../components/ProjectCard.astro";

import {
  projects,
} from "../../data/projects";

import {
  otherWork,
} from "../../data/otherWork";
---

<BaseLayout
  title="Work"
  description="Selected UI/UX design, web development, and technical projects by Alif Rafi Tulusena."
>

  <!-- =====================================================
       HERO
       ===================================================== -->

  <section class="site-container">

    <div
      class="editorial-grid pb-20 pt-16 md:pb-28 md:pt-24"
    >

      <div>
        <p class="mono-label text-muted">
          Work / 2024—2026
        </p>
      </div>


      <div class="editorial-content">
        <h1
          class="max-w-[1150px] text-[clamp(4.5rem,9vw,10rem)] leading-[0.86] font-medium tracking-[-0.07em]"
        >
          Selected
          <span class="text-muted">
            work.
          </span>
        </h1>
      </div>

    </div>


    <!-- Intro -->

    <div
      class="editorial-grid border-y border-line py-8 md:py-9"
    >

      <div>
        <p class="mono-label text-muted">
          Overview
        </p>
      </div>


      <div
        class="editorial-content flex flex-col gap-8 md:flex-row md:items-end md:justify-between"
      >
        <p
          class="max-w-[760px] text-[clamp(1rem,1.05vw,1.1rem)] leading-[1.8] text-muted"
        >
          A selection of projects across UI/UX
          design, web experiences, product
          interfaces, and technical implementation.
        </p>


        <div class="shrink-0 md:text-right">
          <p class="mono-label text-muted">
            Featured
          </p>

          <p
            class="mt-2 text-[15px] leading-[1.6]"
          >
            {projects.length} featured projects
          </p>
        </div>
      </div>

    </div>

  </section>


  <!-- =====================================================
       FEATURED PROJECTS
       ===================================================== -->

  <section
    class="site-container pt-20 md:pt-32"
  >

    <div
      class="editorial-grid pb-12 md:pb-16"
      data-reveal
    >

      <div>
        <p class="mono-label text-muted">
          01 / Featured Projects
        </p>
      </div>


      <div class="editorial-content">
        <h2
          class="section-title"
        >
          Projects where design,
          technology, or both played
          a meaningful role.
        </h2>
      </div>

    </div>


    <div>
      {
        projects.map(
          (project, index) => (
            <ProjectCard
              project={project}
              index={index}
            />
          )
        )
      }
    </div>

  </section>


  <!-- =====================================================
       OTHER WORK
       ===================================================== -->

  <section
    class="site-container py-28 md:py-40 lg:py-44"
  >

    <div
      class="editorial-grid border-t border-line pt-8"
      data-reveal
    >

      <div>
        <p class="mono-label text-muted">
          02 / Other Work
        </p>
      </div>


      <div class="editorial-content">
        {
          otherWork.map(
            (item) => (
              <article
                class="grid gap-5 border-b border-line py-10 first:pt-0 md:grid-cols-[110px_minmax(0,1fr)] md:gap-8"
              >

                <!-- Year -->

                <p
                  class="font-mono text-[11px] uppercase tracking-[0.05em] text-muted"
                >
                  {item.year}
                </p>


                <!-- Main content -->

                <div>
                  <p
                    class="mb-3 font-mono text-[10px] uppercase tracking-[0.07em] text-muted"
                  >
                    {item.category}
                  </p>

                  <h2
                    class="text-[clamp(1.7rem,2.4vw,2.4rem)] leading-[1.12] font-medium tracking-[-0.04em]"
                  >
                    {item.title}
                  </h2>

                  <p
                    class="mt-5 max-w-[760px] text-[clamp(1rem,1.05vw,1.08rem)] leading-[1.8] text-muted"
                  >
                    {item.description}
                  </p>


                  <div
                    class="mt-6 flex flex-wrap gap-x-5 gap-y-2"
                  >
                    {
                      item.tags.map(
                        (tag) => (
                          <span
                            class="font-mono text-[10px] uppercase tracking-[0.05em] text-muted"
                          >
                            {tag}
                          </span>
                        )
                      )
                    }
                  </div>
                </div>

              </article>
            )
          )
        }
      </div>

    </div>

  </section>

</BaseLayout>
