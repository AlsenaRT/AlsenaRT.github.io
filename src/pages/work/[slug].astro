---
import type { GetStaticPaths } from "astro";

import BaseLayout from "../../layouts/BaseLayout.astro";

import {
  projects,
  type Project,
} from "../../data/projects";

export const getStaticPaths = (() => {
  return projects.map((project) => ({
    params: {
      slug: project.slug,
    },

    props: {
      project,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<BaseLayout
  title={project.title}
  description={project.description}
>
  <!-- Project Hero -->

  <section class="site-container pt-16 md:pt-24">
    <div
      class="border-b border-neutral-200 pb-12 md:pb-16"
    >
      <p
        class="mb-8 text-[12px] uppercase tracking-[0.12em] text-neutral-500"
      >
        {project.number} · {project.category}
      </p>

      <h1
        class="max-w-6xl text-[clamp(3.5rem,8vw,8rem)] leading-[0.9] font-medium tracking-[-0.06em]"
      >
        {project.title}
      </h1>
    </div>


    <!-- Metadata -->

    <div
      class="grid gap-8 py-8 text-sm md:grid-cols-12 md:py-10"
    >
      <div class="md:col-span-3">
        <p class="text-neutral-400">
          Year
        </p>

        <p class="mt-2">
          {project.year}
        </p>
      </div>

      <div class="md:col-span-4">
        <p class="text-neutral-400">
          Disciplines
        </p>

        <p class="mt-2">
          {project.disciplines.join(" · ")}
        </p>
      </div>

      <div class="md:col-span-5">
        <p class="text-neutral-400">
          Overview
        </p>

        <p class="mt-2 max-w-lg leading-relaxed">
          {project.description}
        </p>
      </div>
    </div>
  </section>


  <!-- Large project visual placeholder -->

  <section class="site-container py-10 md:py-16">
    <div
      class="flex aspect-[16/9] items-center justify-center bg-neutral-100 text-sm text-neutral-400"
    >
      Main project visual
    </div>
  </section>


  <!-- Case study placeholder -->

  <section class="site-container py-24 md:py-40">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-3">
        <p
          class="text-[12px] uppercase tracking-[0.12em]"
        >
          Case Study
        </p>
      </div>

      <div class="md:col-span-7 md:col-start-5">
        <h2
          class="text-3xl tracking-[-0.04em] md:text-5xl"
        >
          Project content will be built here.
        </h2>

        <p
          class="mt-8 max-w-xl text-lg leading-relaxed text-neutral-600"
        >
          The final case study will include project context,
          process, design decisions, visuals, implementation,
          and outcomes based on the materials available for
          this project.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>