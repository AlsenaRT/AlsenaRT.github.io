---
import type {
  GetStaticPaths,
} from "astro";

import {
  projects,
  type Project,
} from "../../data/projects";

import ProjectLayout
  from "../../layouts/ProjectLayout.astro";


import FmipaCaseStudy
  from "../../case-studies/FmipaCaseStudy.astro";

import MonitoringCaseStudy
  from "../../case-studies/MonitoringCaseStudy.astro";

import RekmedCaseStudy
  from "../../case-studies/RekmedCaseStudy.astro";


export const getStaticPaths = (() => {
  return projects.map(
    (project) => ({
      params: {
        slug: project.slug,
      },

      props: {
        project,
      },
    })
  );
}) satisfies GetStaticPaths;


interface Props {
  project: Project;
}


const {
  project,
} = Astro.props;


const currentIndex =
  projects.findIndex(
    (item) =>
      item.slug === project.slug
  );


const nextProject =
  projects[
    (currentIndex + 1)
    % projects.length
  ];


const caseStudyComponents = {
  "fmipa-website-redesign":
    FmipaCaseStudy,

  "student-performance-monitoring":
    MonitoringCaseStudy,

  "rekmed-product-concepts":
    RekmedCaseStudy,
};


const CaseStudy =
  caseStudyComponents[
    project.slug as keyof typeof caseStudyComponents
  ];
---

<ProjectLayout
  project={project}
  nextProject={nextProject}
>
  <CaseStudy />
</ProjectLayout>