---
import BaseLayout
  from "../layouts/BaseLayout.astro";

import ProjectCard
  from "../components/ProjectCard.astro";

import FolioTeaser
  from "../components/FolioTeaser.astro";

import {
  projects,
} from "../data/projects";

import {
  site,
} from "../data/site";

const featuredProjects =
  projects.slice(0, 3);
---

<BaseLayout>
  <!-- =====================================================
       HERO
       ===================================================== -->

  <section
    class="site-container"
  >
    <div
      class="grid min-h-[calc(100svh-72px)] border-b border-ink md:grid-cols-12"
    >
      <div
        class="flex flex-col justify-between py-10 md:col-span-8 md:py-14 lg:py-16"
      >
        <div>
          <p
            class="rule-label text-accent"
          >
            UI/UX Designer
          </p>
        </div>

        <h1
          class="my-20 max-w-[1100px] text-[clamp(3.8rem,8vw,8.8rem)] leading-[0.88] font-medium tracking-[-0.065em]"
        >
          I design interfaces for
          <span
            class="editorial-serif block text-[0.96em]"
          >
            information-heavy systems.
          </span>
        </h1>

        <p
          class="max-w-xl text-[14px] leading-[1.75] text-muted md:text-[16px]"
        >
          UI/UX designer with a Computer Science
          background. I have worked on institutional
          websites, internal academic systems, and
          product concepts — often close to the people
          responsible for implementing them.
        </p>
      </div>

      <aside
        class="flex flex-col justify-between border-t border-ink py-8 md:col-span-3 md:col-start-10 md:border-t-0 md:border-l md:py-14 md:pl-8 lg:pl-12"
      >
        <div>
          <p
            class="text-[10px] uppercase tracking-[0.08em] text-muted"
          >
            Based in
          </p>

          <p
            class="mt-2 text-[14px]"
          >
            {site.location}
          </p>
        </div>

        <div
          class="my-12 md:my-0"
        >
          <p
            class="text-[10px] uppercase tracking-[0.08em] text-muted"
          >
            Currently
          </p>

          <p
            class="mt-2 max-w-[240px] text-[14px] leading-[1.6]"
          >
            Open to UI/UX and product design
            opportunities.
          </p>
        </div>

        <a
          href="#work"
          class="inline-flex items-center gap-3 text-[13px]"
        >
          Selected work
          <span aria-hidden="true">
            ↓
          </span>
        </a>
      </aside>
    </div>
  </section>


  <!-- =====================================================
       WORK
       ===================================================== -->

  <section
    id="work"
    class="site-container scroll-mt-10 pt-28 md:pt-44"
  >
    <header
      class="grid gap-8 pb-10 md:grid-cols-12 md:pb-14"
    >
      <div
        class="md:col-span-3"
      >
        <p
          class="rule-label"
        >
          Selected work
        </p>
      </div>

      <div
        class="md:col-span-8 md:col-start-5"
      >
        <h2
          class="max-w-[950px] text-[clamp(2.5rem,5vw,5.6rem)] leading-[1] font-medium tracking-[-0.045em]"
        >
          Three projects.
          Three different kinds of
          <span
            class="editorial-serif"
          >
            design problem.
          </span>
        </h2>
      </div>
    </header>

    {
      featuredProjects.map(
        (
          project,
          index
        ) => (
          <ProjectCard
            project={
              project
            }
            index={
              index
            }
          />
        )
      )
    }
  </section>


  <!-- =====================================================
       DESIGN PORTFOLIO PDF
       ===================================================== -->

  <FolioTeaser />


  <!-- =====================================================
       ABOUT
       ===================================================== -->

  <section
    class="site-container pb-24 md:pb-40"
  >
    <div
      class="grid gap-12 border-t border-ink pt-10 md:grid-cols-12"
    >
      <div
        class="md:col-span-3"
      >
        <p
          class="rule-label"
        >
          About
        </p>
      </div>

      <div
        class="md:col-span-8 md:col-start-5"
      >
        <p
          class="max-w-[980px] text-[clamp(2.3rem,4.4vw,5rem)] leading-[1.04] font-medium tracking-[-0.04em]"
        >
          I gravitate toward projects where the
          difficult part is not decoration,
          <span
            class="editorial-serif"
          >
            but structure.
          </span>
        </p>

        <div
          class="mt-10 grid gap-8 text-[15px] leading-[1.8] text-muted md:grid-cols-2"
        >
          <p>
            That has meant reorganizing a faculty
            website, mapping academic rules into a
            role-based monitoring system, and turning
            product requirements into interfaces that
            teams can discuss and build from.
          </p>

          <p>
            My Computer Science background means I am
            comfortable looking past the design file
            when necessary — whether the constraint is
            a CMS, frontend behaviour, relational data,
            or the way an existing system already works.
          </p>
        </div>

        <div
          class="mt-10 flex flex-wrap gap-7 text-[13px]"
        >
          <a
            href="/about/"
            class="border-b border-ink pb-1"
          >
            About me →
          </a>

          <a
            href={site.resume}
            target="_blank"
            rel="noopener noreferrer"
            class="border-b border-ink pb-1"
          >
            Résumé ↗
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>