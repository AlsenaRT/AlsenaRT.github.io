---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

import { projects } from "../data/projects";

const featuredProjects = projects.filter(
  (project) => project.featured
);
---

<BaseLayout>
  <!-- =====================================================
       HERO
       ===================================================== -->

  <section class="site-container">
    <div
      class="flex min-h-[calc(100vh-88px)] flex-col justify-between py-12 md:py-16"
    >
      <div class="pt-[8vh] md:pt-[12vh]">
        <p
          class="mb-6 text-[12px] uppercase tracking-[0.12em] text-neutral-500"
        >
          UI/UX Designer · Computer Science
        </p>

        <h1
          class="max-w-[1200px] text-[clamp(3.25rem,8.5vw,9rem)] leading-[0.9] font-medium tracking-[-0.065em]"
        >
          Designing digital experiences with an understanding of how they're built.
        </h1>
      </div>

      <div
        class="mt-16 flex flex-col gap-6 border-t border-neutral-200 pt-6 md:flex-row md:items-end md:justify-between"
      >
        <p
          class="max-w-lg text-[15px] leading-relaxed text-neutral-600 md:text-base"
        >
          I'm Alif, a Computer Science graduate focused on
          UI/UX design, with experience across product
          design, web development, and implementation.
        </p>

        <a
          href="#selected-work"
          class="text-[13px] uppercase tracking-[0.08em] transition-opacity hover:opacity-50"
        >
          Selected work ↓
        </a>
      </div>
    </div>
  </section>


  <!-- =====================================================
       SELECTED WORK
       ===================================================== -->

  <section
    id="selected-work"
    class="site-container scroll-mt-10 py-24 md:py-32"
  >
    <div
      class="mb-12 flex items-end justify-between border-b border-neutral-200 pb-5 md:mb-16"
    >
      <h2
        class="text-[12px] uppercase tracking-[0.12em]"
      >
        Selected Work
      </h2>

      <span class="text-[12px] text-neutral-400">
        01—03
      </span>
    </div>

    <div class="grid gap-20 md:gap-28">
      {
        featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))
      }
    </div>
  </section>


  <!-- =====================================================
       ABOUT PREVIEW
       ===================================================== -->

  <section class="site-container py-24 md:py-40">
    <div
      class="grid gap-10 border-t border-neutral-200 pt-8 md:grid-cols-12"
    >
      <p
        class="text-[12px] uppercase tracking-[0.12em] md:col-span-3"
      >
        About
      </p>

      <div class="md:col-span-8 md:col-start-5">
        <p
          class="text-3xl leading-[1.15] tracking-[-0.04em] md:text-5xl"
        >
          I work at the intersection of design and
          technology, turning requirements and complex
          information into interfaces that feel clear,
          useful, and intentional.
        </p>

        <a
          href="/about/"
          class="mt-10 inline-block border-b border-black pb-1 text-sm"
        >
          More about me ↗
        </a>
      </div>
    </div>
  </section>


  <!-- =====================================================
       CONTACT
       ===================================================== -->

  <section class="site-container py-24 md:py-40">
    <div class="border-t border-neutral-200 pt-8">
      <p
        class="mb-12 text-[12px] uppercase tracking-[0.12em]"
      >
        Contact
      </p>

      <p
        class="max-w-5xl text-[clamp(3rem,7vw,7rem)] leading-[0.92] font-medium tracking-[-0.06em]"
      >
        Have an opportunity or something interesting to build?
      </p>

      <a
        href="mailto:alifrafitulusena@gmail.com"
        class="mt-12 inline-block text-lg underline decoration-1 underline-offset-8"
      >
        alifrafitulusena@gmail.com ↗
      </a>
    </div>
  </section>
</BaseLayout>