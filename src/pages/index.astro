---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
import { site } from "../data/site";

const featuredProjects =
  projects.filter(
    (project) => project.featured
  );
---

<BaseLayout>
  <section class="site-container">
    <div
      class="flex min-h-[calc(100svh-72px)] flex-col"
    >
      <div
        class="grid gap-3 border-b border-line py-5 font-mono text-[11px] uppercase tracking-[0.07em] text-muted sm:grid-cols-3 md:text-[12px]"
      >
        <p>Alif Rafi Tulusena</p>
        <p class="sm:text-center">UI/UX Designer · Computer Science Graduate</p>
        <p class="sm:text-right">South Tangerang, Indonesia</p>
      </div>

      <div
        class="flex flex-1 items-center py-16 md:py-20"
      >
        <h1
          class="hero-enter display-title max-w-[1320px] text-balance"
        >
          I design clear and intuitive interfaces for
          <span class="text-muted">
            complex, information-heavy systems.
          </span>
        </h1>
      </div>

      <div
        class="grid gap-7 border-t border-line py-6 md:grid-cols-12 md:items-end"
        style="animation-delay: 120ms;"
      >
        <p
          class="max-w-2xl text-[clamp(1rem,1.05vw,1.1rem)] leading-[1.7] text-muted md:col-span-5"
        >
          I'm Alif, a UI/UX designer and Computer Science graduate.
          My work spans institutional websites, internal systems,
          and product concepts, often close to the people responsible
          for building and maintaining them.
        </p>

        <div class="md:col-span-3 md:col-start-7">
          <p class="mono-label text-muted">
            Currently
          </p>

          <p class="mt-2 text-[15px]">
            Open to any software development opportunities
          </p>
        </div>

        <div class="md:col-span-3 md:text-right">
          <a
            href="#selected-work"
            class="text-link"
          >
            View selected work ↓
          </a>
        </div>
      </div>
    </div>
  </section>

  <section
    id="selected-work"
    class="site-container scroll-mt-24 pt-28 md:pt-44"
  >
    <div
      class="editorial-grid pb-12 md:pb-16"
      data-reveal
    >
      <div>
        <p class="mono-label text-muted">
          01 / Selected Work
        </p>
      </div>

      <div class="editorial-content">
        <div class="flex items-end justify-between gap-8">
          <h2 class="section-title text-balance">
            Work shaped by real content, real constraints,
            and the systems behind the interface.
          </h2>

          <p
            class="hidden shrink-0 font-mono text-[11px] text-muted md:block"
          >
            01—03
          </p>
        </div>
      </div>
    </div>

    <div>
      {
        featuredProjects.map(
          (project, index) => (
            <ProjectCard
              project={project}
              index={index}
            />
          )
        )
      }
    </div>
  </section>

  <section
    class="site-container py-28 md:py-48"
  >
    <div
      class="editorial-grid border-t border-line pt-8"
      data-reveal
    >
      <div>
        <p class="mono-label text-muted">
          02 / About
        </p>
      </div>

      <div class="editorial-content">
        <p class="section-title text-balance">
          I like design problems where the hard part
          isn't just how something looks, but how it works.
        </p>

        <div
          class="mt-12 grid gap-8 md:grid-cols-2"
        >
          <p
            class="max-w-[520px] text-[clamp(1rem,1.05vw,1.1rem)] leading-[1.8] text-muted"
          >
            That has meant reorganizing a faculty website,
            mapping academic rules into a role-based monitoring
            system, and turning product requirements into
            interfaces people can discuss and build from.
          </p>

          <p
            class="max-w-[520px] text-[clamp(1rem,1.05vw,1.1rem)] leading-[1.8] text-muted"
          >
            I work primarily in UI/UX, but I'm comfortable
            going into the technical side when a project calls
            for it — from CMS constraints and frontend behavior
            to data relationships and implementation trade-offs.
          </p>
        </div>

        <div class="mt-12 flex flex-wrap gap-7">
          <a
            href="/about/"
            class="text-link"
          >
            More about me ↗
          </a>

          <a
            href={site.resume}
            target="_blank"
            class="text-link"
          >
            View résumé ↗
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
