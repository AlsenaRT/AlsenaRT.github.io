---
import BaseLayout from "../layouts/BaseLayout.astro";

import ProjectCard from "../components/ProjectCard.astro";

import {
  projects,
} from "../data/projects";

const featuredProjects =
  projects.filter(
    (project) => project.featured
  );
---

<BaseLayout>

  <!-- =====================================================
       HERO
       ===================================================== -->

  <section class="site-container">
    <div
      class="flex min-h-[calc(100svh-72px)] flex-col"
    >

      <!-- Hero metadata -->

      <div
        class="grid gap-3 border-b border-line py-5 font-mono text-[10px] uppercase tracking-[0.07em] text-muted sm:grid-cols-3"
      >
        <p>
          Portfolio / 2026
        </p>

        <p class="sm:text-center">
          UI/UX Designer
        </p>

        <p class="sm:text-right">
          South Tangerang, Indonesia
        </p>
      </div>


      <!-- Main statement -->

      <div
        class="flex flex-1 items-center py-16 md:py-20"
      >
        <h1
          class="display-title max-w-[1450px] text-balance"
        >
          I design digital experiences that make
          <span class="text-muted">
            complex things feel clear.
          </span>
        </h1>
      </div>


      <!-- Hero footer -->

      <div
        class="grid gap-7 border-t border-line py-6 md:grid-cols-12 md:items-end"
      >
        <p
          class="max-w-xl text-[14px] leading-[1.65] text-muted md:col-span-5"
        >
          Computer Science graduate focused on
          UI/UX design, combining interface
          thinking with an understanding of web
          development and implementation.
        </p>

        <div
          class="md:col-span-3 md:col-start-7"
        >
          <p class="mono-label text-muted">
            Currently
          </p>

          <p class="mt-2 text-[13px]">
            Open to UI/UX opportunities
          </p>
        </div>

        <div
          class="md:col-span-3 md:text-right"
        >
          <a
            href="#selected-work"
            class="text-link text-[13px]"
          >
            View selected work ↓
          </a>
        </div>
      </div>

    </div>
  </section>


  <!-- =====================================================
       SELECTED WORK INTRODUCTION
       ===================================================== -->

  <section
    id="selected-work"
    class="site-container scroll-mt-24 pt-28 md:pt-44"
  >
    <div
      class="grid gap-10 pb-12 md:grid-cols-12 md:pb-16"
    >
      <div class="md:col-span-3">
        <p class="mono-label text-muted">
          01 / Selected Work
        </p>
      </div>

      <div
        class="md:col-span-7 md:col-start-5"
      >
        <h2
          class="section-title text-balance"
        >
          A selection of work across product design,
          web experiences, and technical implementation.
        </h2>
      </div>

      <div
        class="flex items-end justify-end md:col-span-1 md:col-start-12"
      >
        <p
          class="font-mono text-[11px] text-muted"
        >
          01—03
        </p>
      </div>
    </div>


    <!-- Projects -->

    <div>
      {
        featuredProjects.map(
          (project, index) => (
            <ProjectCard
              project={project}
              index={index}
            />
          )
        )
      }
    </div>
  </section>


  <!-- =====================================================
       ABOUT
       ===================================================== -->

  <section
    class="site-container py-28 md:py-48"
  >
    <div
      class="grid gap-12 border-t border-line pt-8 md:grid-cols-12"
    >
      <div class="md:col-span-3">
        <p class="mono-label text-muted">
          02 / About
        </p>
      </div>

      <div
        class="md:col-span-8 md:col-start-5"
      >
        <p
          class="section-title text-balance"
        >
          I work between design and technology,
          translating requirements into interfaces
          that are useful, structured, and intentional.
        </p>

        <div
          class="mt-12 grid gap-8 md:grid-cols-2"
        >
          <p
            class="max-w-sm text-[14px] leading-[1.75] text-muted"
          >
            My primary focus is UI/UX design,
            supported by a Computer Science
            background and hands-on experience
            developing web-based systems.
          </p>

          <p
            class="max-w-sm text-[14px] leading-[1.75] text-muted"
          >
            That combination allows me to think
            beyond how an interface looks and
            consider how it behaves, scales, and
            eventually gets implemented.
          </p>
        </div>

        <a
          href="/about/"
          class="text-link mt-12 text-[13px]"
        >
          More about me ↗
        </a>
      </div>
    </div>
  </section>


  <!-- =====================================================
       CAPABILITIES
       ===================================================== -->

  <section
    class="site-container pb-24 md:pb-40"
  >
    <div
      class="grid gap-12 border-t border-line pt-8 md:grid-cols-12"
    >
      <div class="md:col-span-3">
        <p class="mono-label text-muted">
          03 / Capabilities
        </p>
      </div>


      <!-- Design -->

      <div
        class="md:col-span-3 md:col-start-5"
      >
        <p
          class="mb-6 text-[13px] font-semibold"
        >
          Design
        </p>

        <div
          class="space-y-3 text-[14px] text-muted"
        >
          <p>UI/UX Design</p>
          <p>Interface Design</p>
          <p>Responsive Web Design</p>
          <p>Figma</p>
        </div>
      </div>


      <!-- Technical -->

      <div
        class="md:col-span-3 md:col-start-9"
      >
        <p
          class="mb-6 text-[13px] font-semibold"
        >
          Technical
        </p>

        <div
          class="space-y-3 text-[14px] text-muted"
        >
          <p>HTML / CSS / JavaScript</p>
          <p>PHP / MySQL</p>
          <p>WordPress</p>
          <p>Git</p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>