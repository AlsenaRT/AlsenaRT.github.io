---
import type {
  Project,
} from "../data/projects";

interface Props {
  project: Project;
}

const {
  project,
} = Astro.props;
---

<article
  class="border-t border-line"
>
  <a
    href={`/work/${project.slug}/`}
    class="group grid gap-6 py-8 md:grid-cols-12 md:py-10"
  >
    <!-- Number / metadata -->

    <div
      class="flex items-start justify-between md:col-span-2 md:block"
    >
      <p
        class="text-[10px] tracking-[0.08em] text-accent"
      >
        {project.number}
      </p>

      <div
        class="text-right text-[10px] uppercase tracking-[0.07em] text-muted md:mt-5 md:text-left"
      >
        <p>
          {project.year}
        </p>

        <p class="mt-1">
          {project.category}
        </p>
      </div>
    </div>


    <!-- Title -->

    <div
      class="md:col-span-5"
    >
      <h2
        class="max-w-xl text-[clamp(1.9rem,3.3vw,3.8rem)] leading-[1] font-medium tracking-[-0.045em] transition-opacity duration-300 group-hover:opacity-55"
      >
        {project.title}
      </h2>
    </div>


    <!-- Description -->

    <div
      class="md:col-span-4"
    >
      <p
        class="max-w-lg text-[14px] leading-[1.75] text-muted"
      >
        {project.description}
      </p>

      <div
        class="mt-5 flex flex-wrap gap-x-4 gap-y-2"
      >
        {
          project.disciplines.map(
            (discipline) => (
              <span
                class="text-[9px] uppercase tracking-[0.07em] text-muted"
              >
                {discipline}
              </span>
            )
          )
        }
      </div>
    </div>


    <!-- Arrow -->

    <div
      class="hidden justify-end md:col-span-1 md:flex"
    >
      <span
        aria-hidden="true"
        class="text-xl transition-transform duration-300 group-hover:translate-x-2"
      >
        →
      </span>
    </div>
  </a>
</article>