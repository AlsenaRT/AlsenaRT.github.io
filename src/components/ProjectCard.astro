---
import type { Project } from "../data/projects";
import ProjectPreview from "./ProjectPreview.astro";

interface Props {
  project: Project;
  index: number;
}

const {
  project,
  index,
} = Astro.props;

const reversed = index % 2 === 1;
---

<article
  class="group border-t border-line py-10 md:py-16"
  data-reveal
>
  <a
    href={`/work/${project.slug}/`}
    class="grid gap-8 md:grid-cols-12 md:gap-0"
  >
    <div
      class:list={[
        "flex flex-col justify-between md:col-span-4",
        reversed
          ? "md:order-2 md:pl-10 lg:pl-16"
          : "md:pr-10 lg:pr-16",
      ]}
    >
      <div
        class="flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.06em] text-muted"
      >
        <span>{project.number}</span>
        <span>{project.year}</span>
      </div>

      <div class="mt-16 md:mt-32">
        <p
          class="mb-3 font-mono text-[10px] uppercase tracking-[0.08em] text-muted"
        >
          {project.category}
        </p>

        <h3
          class="text-[clamp(2rem,3vw,3.4rem)] leading-[0.98] font-medium tracking-[-0.05em] transition-opacity duration-300 group-hover:opacity-55"
        >
          {project.title}
        </h3>

        <p
          class="mt-5 max-w-[620px] text-[clamp(0.98rem,1vw,1.08rem)] leading-[1.75] text-muted"
        >
          {project.description}
        </p>

        <div
          class="mt-8 flex flex-wrap gap-x-4 gap-y-2"
        >
          {
            project.disciplines.map(
              (discipline) => (
                <span
                  class="font-mono text-[10px] uppercase tracking-[0.07em] text-muted"
                >
                  {discipline}
                </span>
              )
            )
          }
        </div>

        <span
          class="mt-10 inline-flex items-center gap-2 text-[14px]"
        >
          View project

          <span
            class="transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1"
            aria-hidden="true"
          >
            ↗
          </span>
        </span>
      </div>
    </div>

    <div
      class:list={[
        "md:col-span-8",
        reversed
          ? "md:order-1"
          : "",
      ]}
    >
      <ProjectPreview
        project={project}
      />
    </div>
  </a>
</article>
