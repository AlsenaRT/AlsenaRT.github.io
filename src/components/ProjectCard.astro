---
import type {
  Project,
} from "../data/projects";

interface Props {
  project: Project;
  index?: number;
}

const {
  project,
} = Astro.props;
---

<article
  class="border-t border-line py-10 md:py-16"
>
  <a
    href={`/work/${project.slug}/`}
    class="group block"
  >
    <div
      class="project-cover relative isolate aspect-[16/11] overflow-hidden md:aspect-[16/8]"
    >
      <img
        src={project.cover}
        alt={project.coverAlt}
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover"
        style={`object-position: ${project.coverPosition ?? "50% 0%"};
        --cover-scale: ${project.coverScale ?? 1};
        `}
      />

      <span
        class="absolute top-4 left-4 z-10 flex h-10 w-10 items-center justify-center bg-paper text-[11px] font-medium md:top-6 md:left-6"
        aria-hidden="true"
      >
        {project.number}
      </span>
    </div>

    <div
      class="grid gap-8 pt-6 md:grid-cols-12 md:pt-8"
    >
      <div
        class="flex justify-between text-[11px] uppercase tracking-[0.07em] text-muted md:col-span-2 md:block"
      >
        <p>
          {project.number}
        </p>

        <p class="md:mt-2">
          {project.year}
        </p>
      </div>

      <div
        class="md:col-span-6"
      >
        <p
          class="mb-3 text-[11px] uppercase tracking-[0.07em] text-accent"
        >
          {project.category}
        </p>

        <h3
          class="max-w-[760px] text-[clamp(2rem,4vw,4.5rem)] leading-[0.96] font-medium tracking-[-0.045em]"
        >
          {project.title}
        </h3>
      </div>

      <div
        class="md:col-span-4"
      >
        <p
          class="max-w-xl text-[clamp(0.95rem,1vw,1.05rem)] leading-[1.75] text-muted"
        >
          {project.description}
        </p>

        <div
          class="mt-6 flex flex-wrap gap-x-4 gap-y-2"
        >
          {
            project.disciplines.map(
              (discipline) => (
                <span
                  class="text-[10px] uppercase tracking-[0.07em] text-muted"
                >
                  {discipline}
                </span>
              )
            )
          }
        </div>

        <span
          class="mt-8 inline-flex items-center gap-3 text-[13px]"
        >
          Read case study

          <span
            aria-hidden="true"
            class="transition-transform duration-300 group-hover:translate-x-1"
          >
            →
          </span>
        </span>
      </div>
    </div>
  </a>
</article>