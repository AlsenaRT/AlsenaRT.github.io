---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  index: number;
}

const {
  project,
  index,
} = Astro.props;

const reversed =
  index % 2 === 1;
---

<article
  class="group border-t border-line py-10 md:py-16"
>
  <a
    href={`/work/${project.slug}/`}
    class="grid gap-8 md:grid-cols-12 md:gap-0"
  >
    <!-- ===================================================
         PROJECT INFORMATION
         =================================================== -->

    <div
      class:list={[
        "flex flex-col justify-between md:col-span-4",
        reversed
          ? "md:order-2 md:pl-10 lg:pl-16"
          : "md:pr-10 lg:pr-16",
      ]}
    >
      <div>
        <div
          class="mb-8 flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.06em] text-muted md:mb-0"
        >
          <span>
            {project.number}
          </span>

          <span>
            {project.year}
          </span>
        </div>
      </div>

      <div class="md:pt-32">
        <p
          class="mb-3 font-mono text-[10px] uppercase tracking-[0.08em] text-muted"
        >
          {project.category}
        </p>

        <h3
          class="text-[clamp(2rem,3vw,3.5rem)] leading-[0.98] font-medium tracking-[-0.05em]"
        >
          {project.title}
        </h3>

        <p
          class="mt-5 max-w-sm text-[14px] leading-[1.7] text-muted"
        >
          {project.description}
        </p>

        <div
          class="mt-8 flex flex-wrap gap-x-4 gap-y-2"
        >
          {
            project.disciplines.map(
              (discipline) => (
                <span
                  class="font-mono text-[10px] uppercase tracking-[0.05em] text-muted"
                >
                  {discipline}
                </span>
              )
            )
          }
        </div>

        <span
          class="mt-10 inline-flex items-center gap-2 text-[13px]"
        >
          View case study

          <span
            class="transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1"
          >
            ↗
          </span>
        </span>
      </div>
    </div>


    <!-- ===================================================
         PROJECT VISUAL
         =================================================== -->

    <div
      class:list={[
        "md:col-span-8",
        reversed
          ? "md:order-1"
          : "",
      ]}
    >
      <div
        class="relative aspect-[4/3] overflow-hidden bg-panel"
      >
        <!-- Temporary visual -->

        <div
          class="absolute inset-0 flex items-center justify-center"
        >
          <span
            class="font-mono text-[clamp(5rem,13vw,12rem)] font-medium tracking-[-0.08em] text-ink/10 transition-all duration-700 ease-out group-hover:scale-[1.04] group-hover:text-ink/15"
          >
            {project.number}
          </span>
        </div>


        <!-- Top label -->

        <div
          class="absolute top-5 left-5 font-mono text-[10px] uppercase tracking-[0.08em] text-muted md:top-7 md:left-7"
        >
          Project preview
        </div>


        <!-- Corner -->

        <div
          class="absolute right-5 bottom-5 flex h-10 w-10 items-center justify-center border border-ink/20 text-sm transition-all duration-300 group-hover:bg-ink group-hover:text-paper md:right-7 md:bottom-7"
        >
          ↗
        </div>
      </div>
    </div>
  </a>
</article>