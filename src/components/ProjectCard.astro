---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="group">
  <a
    href={`/work/${project.slug}/`}
    class="block"
  >
    <div
      class="aspect-[16/10] overflow-hidden bg-neutral-100"
    >
      <div
        class="flex h-full items-center justify-center text-sm text-neutral-400 transition-transform duration-700 ease-out group-hover:scale-[1.02]"
      >
        Project image — {project.shortTitle}
      </div>
    </div>

    <div
      class="mt-5 flex items-start justify-between gap-6"
    >
      <div>
        <div
          class="mb-2 flex flex-wrap gap-x-3 gap-y-1 text-[12px] uppercase tracking-[0.08em] text-neutral-500"
        >
          <span>{project.number}</span>

          <span>{project.category}</span>

          <span>{project.year}</span>
        </div>

        <h3
          class="text-xl font-medium tracking-[-0.03em] md:text-2xl"
        >
          {project.title}
        </h3>
      </div>

      <span
        aria-hidden="true"
        class="mt-1 text-xl transition-transform duration-300 group-hover:translate-x-1"
      >
        ↗
      </span>
    </div>
  </a>
</article>