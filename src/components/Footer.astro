---
const year = new Date().getFullYear();
---

<footer class="site-container mt-24 md:mt-40">
  <div class="border-t border-line">
    <!-- Contact CTA -->

    <div
      class="grid gap-10 py-16 md:grid-cols-12 md:py-24"
    >
      <div class="md:col-span-3">
        <p class="mono-label text-muted">
          Contact
        </p>
      </div>

      <div
        class="md:col-span-8 md:col-start-5"
      >
        <p
          class="section-title text-balance"
        >
          Have a role, project, or idea worth talking about?
        </p>

        <a
          href="mailto:alifrafitulusena@gmail.com"
          class="text-link mt-10 text-base md:text-lg"
        >
          alifrafitulusena@gmail.com ↗
        </a>
      </div>
    </div>


    <!-- Bottom footer -->

    <div
      class="flex flex-col gap-6 border-t border-line py-7 text-[12px] text-muted md:flex-row md:items-center md:justify-between"
    >
      <p class="font-mono">
        © {year} Alif Rafi Tulusena
      </p>

      <div class="flex gap-6">
        <a
          href="mailto:alifrafitulusena@gmail.com"
          class="transition-colors hover:text-ink"
        >
          Email
        </a>

        <a
          href="https://www.linkedin.com/in/alifrafitulusena"
          target="_blank"
          rel="noreferrer"
          class="transition-colors hover:text-ink"
        >
          LinkedIn ↗
        </a>
      </div>

      <p class="font-mono">
        Designed & built by Alif
      </p>
    </div>
  </div>
</footer>