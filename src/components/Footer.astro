---
import {
  site,
} from "../data/site";

const year =
  new Date().getFullYear();
---

<footer
  class="site-container"
>
  <div
    class="border-t border-ink"
  >
    <!-- Contact -->

    <div
      class="grid gap-12 py-12 md:grid-cols-12 md:py-16"
    >
      <div
        class="md:col-span-3"
      >
        <p
          class="rule-label text-accent"
        >
          Contact
        </p>
      </div>


      <div
        class="md:col-span-8 md:col-start-5"
      >
        <h2
          class="max-w-[820px] text-[clamp(2.1rem,4vw,4.5rem)] leading-[1.04] font-medium tracking-[-0.04em]"
        >
          I'm currently open to any UI/UX,
          product design, and software
          development opportunities.
        </h2>


        <p
          class="mt-7 max-w-xl text-[14px] leading-[1.75] text-muted"
        >
          If my work looks relevant to a role,
          project, or team you're building,
          feel free to get in touch.
        </p>


        <a
          href={`mailto:${site.email}`}
          class="mt-9 inline-block border-b border-ink pb-1 text-[15px]"
        >
          {site.email} ↗
        </a>
      </div>
    </div>


    <!-- Footer utility -->

    <div
      class="grid gap-5 border-t border-line py-6 text-[11px] text-muted md:grid-cols-3 md:items-center"
    >
      <p>
        © {year} {site.name}
      </p>


      <nav
        aria-label="Footer navigation"
        class="flex flex-wrap gap-6 md:justify-center"
      >
        <a
          href="/work/"
          class="transition-colors hover:text-ink"
        >
          Work
        </a>

        <a
          href="/folio/"
          class="transition-colors hover:text-ink"
        >
          Folio
        </a>

        <a
          href="/about/"
          class="transition-colors hover:text-ink"
        >
          About
        </a>

        <a
          href={site.links.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-ink"
        >
          LinkedIn ↗
        </a>

        <a
          href={site.links.github}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-ink"
        >
          GitHub ↗
        </a>
      </nav>


      <p
        class="md:text-right"
      >
        {site.location}
      </p>
    </div>
  </div>
</footer>