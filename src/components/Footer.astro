---
import {
  site,
} from "../data/site";

const year =
  new Date().getFullYear();
---

<footer
  class="site-container"
>
  <div
    class="border-t border-ink"
  >
    <div
      class="grid gap-12 py-12 md:grid-cols-12 md:py-16"
    >
      <div
        class="md:col-span-3"
      >
        <p
          class="rule-label text-accent"
        >
          Contact
        </p>
      </div>

      <div
        class="md:col-span-8 md:col-start-5"
      >
        <p
          class="max-w-4xl text-[clamp(2.7rem,5vw,5.8rem)] leading-[0.96] font-medium tracking-[-0.05em]"
        >
          Available for thoughtful
          <span
            class="editorial-serif"
          >
            design work.
          </span>
        </p>

        <a
          href={`mailto:${site.email}`}
          class="mt-10 inline-block border-b border-ink pb-1 text-[15px]"
        >
          {site.email} ↗
        </a>
      </div>
    </div>

    <div
      class="grid gap-5 border-t border-line py-6 text-[11px] text-muted md:grid-cols-3 md:items-center"
    >
      <p>
        © {year} {site.name}
      </p>

      <div
        class="flex gap-6 md:justify-center"
      >
        <a
          href={site.links.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-ink"
        >
          LinkedIn ↗
        </a>

        <a
          href={site.links.github}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-ink"
        >
          GitHub ↗
        </a>

        <a
          href="/folio/"
          class="hover:text-ink"
        >
          Folio
        </a>
      </div>

      <p
        class="md:text-right"
      >
        South Tangerang, Indonesia
      </p>
    </div>
  </div>
</footer>