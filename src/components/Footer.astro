---
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-container mt-24 md:mt-40">
  <div class="border-t border-line">

    <!-- ===================================================
         CONTACT CTA
         =================================================== -->

    <div
      class="editorial-grid"
    >
      <div>
        <p class="mono-label text-muted">
          Contact
        </p>
      </div>

      <div
        class="editorial-content"
      >
        <h2
          class="max-w-[900px] text-[clamp(2.8rem,5vw,5.8rem)] leading-[1.02] font-medium tracking-[-0.045em]"
        >
          Have a role, project, or idea worth talking about?
        </h2>

        <a
          href={`mailto:${site.email}`}
          class="text-link mt-10 text-base md:text-lg"
        >
          {site.email} ↗
        </a>
      </div>
    </div>


    <!-- ===================================================
         FOOTER META
         =================================================== -->

    <div
      class="grid gap-6 border-t border-line py-7 text-[11px] md:text-[12px] text-muted md:grid-cols-3 md:items-center"
    >
      <p class="font-mono">
        © {year} {site.name}
      </p>

      <div
        class="flex gap-6 md:justify-center"
      >
        <a
          href={`mailto:${site.email}`}
          class="transition-colors duration-200 hover:text-ink"
        >
          Email
        </a>

        <a
          href={site.links.linkedin}
          target="_blank"
          rel="noreferrer"
          class="transition-colors duration-200 hover:text-ink"
        >
          LinkedIn ↗
        </a>

        <a
          href={site.links.github}
          target="_blank"
          rel="noreferrer"
          class="transition-colors duration-200 hover:text-ink"
        >
          GitHub ↗
        </a>
      </div>

      <p
        class="font-mono md:text-right"
      >
        Designed & built by Alif
      </p>
    </div>

  </div>
</footer>