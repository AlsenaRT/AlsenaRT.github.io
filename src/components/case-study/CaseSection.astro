---
interface Props {
  number?: string;
  label: string;
  title?: string;
  intro?: string;
}

const {
  number,
  label,
  title,
  intro,
} = Astro.props;
---

<section
  class="site-container py-20 md:py-24 lg:py-28"
  data-reveal
>
  <div
    class="editorial-grid border-t border-line pt-8"
  >

    <div>
      <p class="mono-label text-muted">
        {
          number
            ? `${number} / ${label}`
            : label
        }
      </p>
    </div>


    <div class="editorial-content">

      <div class="case-section-flow">

        {
          title && (
            <h2
              class="section-title"
            >
              {title}
            </h2>
          )
        }


        {
          intro && (
            <p class="case-intro">
              {intro}
            </p>
          )
        }


        <div class="case-copy">
          <slot />
        </div>

      </div>

    </div>

  </div>
</section>