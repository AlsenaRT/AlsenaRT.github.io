---
interface Props {
  number?: string;
  label: string;
  title?: string;
  intro?: string;
}

const {
  number,
  label,
  title,
  intro,
} = Astro.props;
---

<section
  class="site-container py-20 md:py-32 lg:py-40"
  data-reveal
>
  <div
    class="grid gap-10 border-t border-line pt-8 md:grid-cols-12"
  >
    <!-- Section label -->

    <div class="md:col-span-3">
      <p class="mono-label text-muted">
        {
          number
            ? `${number} / ${label}`
            : label
        }
      </p>
    </div>


    <!-- Content -->

    <div
      class="md:col-span-7 md:col-start-5"
    >
      {
        title && (
          <h2
            class="section-title max-w-4xl text-balance"
          >
            {title}
          </h2>
        )
      }

      {
        intro && (
          <p
            class:list={[
              "max-w-2xl text-[15px] leading-[1.8] text-muted md:text-base",
              {
                "mt-8": title,
              },
            ]}
          >
            {intro}
          </p>
        )
      }

      <div
        class:list={[
          "case-copy",
          {
            "mt-10":
              title || intro,
          },
        ]}
      >
        <slot />
      </div>
    </div>
  </div>
</section>