---
interface Props {
  src: string;
  alt: string;

  title: string;
  description?: string;
  number?: string;

  tone?:
    | "paper"
    | "warm"
    | "blue"
    | "dark";

  previewPosition?:
    | "top"
    | "center"
    | "bottom";
}


const {
  src,
  alt,
  title,
  description,
  number,
  tone = "paper",
  previewPosition = "top",
} = Astro.props;


const toneClasses = {
  paper:
    "bg-[#e7e3d8]",

  warm:
    "bg-[#ddd7ca]",

  blue:
    "bg-[#173d61]",

  dark:
    "bg-[#161715]",
};


const positionClasses = {
  top:
    "object-top",

  center:
    "object-center",

  bottom:
    "object-bottom",
};
---

<section
  class="site-container py-16 md:py-24"
>
  <div
    class="grid gap-10 md:grid-cols-12"
  >

    <!-- Information -->

    <div
      class="md:col-span-3"
    >
      {
        number && (
          <p
            class="text-[10px] uppercase tracking-[0.08em] text-accent"
          >
            {number}
          </p>
        )
      }

      <p
        class="mt-3 text-[10px] uppercase tracking-[0.08em] text-muted"
      >
        Page study
      </p>
    </div>


    <div
      class="md:col-span-8 md:col-start-5"
    >
      <h3
        class="max-w-3xl text-[clamp(2.2rem,4vw,4.6rem)] leading-[0.98] font-medium tracking-[-0.045em]"
      >
        {title}
      </h3>

      {
        description && (
          <p
            class="mt-6 max-w-xl text-[14px] leading-[1.75] text-muted"
          >
            {description}
          </p>
        )
      }
    </div>
  </div>


  <!-- Cropped page specimen -->

  <div
    class:list={[
      "mt-10 p-3 sm:p-5 md:mt-14 md:p-8 lg:p-10",
      toneClasses[tone],
    ]}
  >
    <div
      class="relative mx-auto aspect-[16/10] max-w-[1400px] overflow-hidden bg-white"
    >
      <img
        src={src}
        alt={alt}
        loading="lazy"
        decoding="async"
        class:list={[
          "absolute inset-0 h-full w-full object-cover",
          positionClasses[
            previewPosition
          ],
        ]}
      />
    </div>
  </div>


  <!-- Full page -->

  <details
    class="group border-b border-line"
  >
    <summary
      class="flex cursor-pointer list-none items-center justify-between py-6"
    >
      <div
        class="flex items-center gap-4"
      >
        <span
          class="text-[10px] uppercase tracking-[0.08em] text-muted"
        >
          Full page
        </span>

        <span
          class="text-[12px]"
        >
          View complete design
        </span>
      </div>

      <span
        aria-hidden="true"
        class="text-xl transition-transform duration-300 group-open:rotate-45"
      >
        +
      </span>
    </summary>


    <div
      class="pb-10 md:pb-16"
    >
      <div
        class:list={[
          "p-3 sm:p-5 md:p-8 lg:p-12",
          toneClasses[tone],
        ]}
      >
        <img
          src={src}
          alt=""
          loading="lazy"
          decoding="async"
          class="mx-auto block h-auto w-full max-w-[1200px]"
        />
      </div>
    </div>
  </details>
</section>