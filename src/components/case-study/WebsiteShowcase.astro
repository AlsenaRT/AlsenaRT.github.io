---
interface Props {
  src: string;
  alt: string;

  title: string;

  description?: string;

  number?: string;

  tone?:
    | "paper"
    | "warm"
    | "blue"
    | "dark";

  previewPosition?:
    | "top"
    | "center"
    | "bottom";
}

const {
  src,
  alt,
  title,
  description,
  number,

  tone = "paper",

  previewPosition = "top",
} = Astro.props;


const toneClasses = {
  paper:
    "bg-[#ebe9e2]",

  warm:
    "bg-[#e7e2d8]",

  blue:
    "bg-[#173d61]",

  dark:
    "bg-[#1b1c1a]",
};


const positionClasses = {
  top:
    "object-top",

  center:
    "object-center",

  bottom:
    "object-bottom",
};
---

<section
  class="site-container py-14 md:py-20"
  data-reveal
>

<!-- =====================================================
     SHOWCASE HEADER
     ===================================================== -->

<div
  class="editorial-grid mb-8"
>

  <div>
    {
      number && (
        <p class="mono-label text-muted">
          {number}
        </p>
      )
    }
  </div>


<div class="editorial-content">

    <div class="showcase-heading-flow">

        <h3
            class="text-[clamp(2rem,3.2vw,3.4rem)] leading-[1.1] font-medium tracking-[-0.025em]"
        >
            {title}
        </h3>


        {
            description && (
                <p
                    class="showcase-description"
                >
                    {description}
                </p>
            )
        }

    </div>

</div>

</div>


  <!-- =====================================================
       LARGE CROPPED PREVIEW
       ===================================================== -->

  <div
    class:list={[
      "p-3 sm:p-5 md:p-7 lg:p-9",
      toneClasses[tone],
    ]}
  >

    <div
      class="mx-auto max-w-[1280px] overflow-hidden border border-black/10 bg-white shadow-[0_24px_70px_rgba(0,0,0,0.12)]"
    >

      <!-- Browser chrome -->

      <div
        class="flex h-10 items-center justify-between border-b border-black/10 bg-[#f7f7f5] px-4"
      >

        <div class="flex gap-1.5">
          <span
            class="h-2 w-2 rounded-full bg-black/15"
          ></span>

          <span
            class="h-2 w-2 rounded-full bg-black/15"
          ></span>

          <span
            class="h-2 w-2 rounded-full bg-black/15"
          ></span>
        </div>


        <p
          class="font-mono text-[8px] uppercase tracking-[0.08em] text-black/30"
        >
          FMIPA UGM
        </p>


        <span
          class="w-8"
          aria-hidden="true"
        ></span>

      </div>


      <!-- Screenshot viewport -->

      <div
        class="relative aspect-video overflow-hidden bg-white"
      >
        <img
          src={src}
          alt={alt}
          loading="lazy"
          decoding="async"
          class:list={[
            "absolute inset-0 h-full w-full object-cover",
            positionClasses[
              previewPosition
            ],
          ]}
        />
      </div>

    </div>

  </div>


  <!-- =====================================================
       EXPAND CONTROL
       ===================================================== -->

  <details
    class="group border-b border-line"
  >

    <summary
      class="flex cursor-pointer list-none items-center justify-between py-6 md:py-7"
    >

      <div>
        <p
          class="text-[14px] font-medium tracking-[-0.015em] md:text-[15px]"
        >
          Expand the page
        </p>

        <p
          class="mt-1 font-mono text-[9px] uppercase tracking-[0.06em] text-muted"
        >
          View the complete long-form design
        </p>
      </div>


      <span
        class="flex h-9 w-9 items-center justify-center rounded-full border border-line text-lg transition-all duration-300 group-open:rotate-45 group-hover:bg-ink group-hover:text-paper"
        aria-hidden="true"
      >
        +
      </span>

    </summary>


    <!-- Full page -->

    <div
      class="pb-10 md:pb-14"
    >

      <div
        class:list={[
          "p-3 sm:p-5 md:p-8",
          toneClasses[tone],
        ]}
      >

        <div
          class="mx-auto max-w-[1100px] overflow-hidden border border-black/10 bg-white shadow-[0_20px_60px_rgba(0,0,0,0.10)]"
        >

          <div
            class="flex h-10 items-center gap-1.5 border-b border-black/10 bg-[#f7f7f5] px-4"
          >
            <span
              class="h-2 w-2 rounded-full bg-black/15"
            ></span>

            <span
              class="h-2 w-2 rounded-full bg-black/15"
            ></span>

            <span
              class="h-2 w-2 rounded-full bg-black/15"
            ></span>
          </div>


          <img
            src={src}
            alt=""
            loading="lazy"
            decoding="async"
            class="block h-auto w-full"
          />

        </div>

      </div>

    </div>

  </details>

</section>