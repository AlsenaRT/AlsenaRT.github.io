---
import type { Project }
  from "../data/projects";

interface Props {
  project: Project;

  variant?:
    | "card"
    | "hero";
}

const {
  project,

  variant = "card",
} = Astro.props;

const frameClass =
  variant === "hero"
    ? "aspect-[16/9] md:aspect-[16/8]"
    : "aspect-[4/3]";
---

<div
  class:list={[
    "project-preview relative overflow-hidden",
    frameClass,
  ]}
>

  <!-- =====================================================
       FMIPA
       ===================================================== -->

  {
    project.preview === "fmipa" && (
      <div
        class="absolute inset-0 overflow-hidden bg-[#173d61]"
      >
        <!-- Background identity -->

        <div
          class="absolute inset-x-0 top-0 flex items-center justify-between px-[5%] py-[4%]"
        >
          <p
            class="font-mono text-[8px] uppercase tracking-[0.12em] text-white/50"
          >
            FMIPA UGM / Website Redesign
          </p>

          <p
            class="font-mono text-[8px] uppercase tracking-[0.12em] text-white/50"
          >
            2026
          </p>
        </div>


        <!-- Main browser-like composition -->

        <div
          class="absolute bottom-[-12%] left-[7%] top-[13%] w-[70%]
          flex-col overflow-hidden bg-paper shadow-[0_30px_80px_rgba(0,0,0,0.22)]
          transition-transform duration-700 ease-out
          group-hover:-translate-y-2"
        >
          <!-- browser bar -->

          <div
            class="flex h-[6%] items-center gap-1.5 border-b border-black/10 px-[3%]"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-black/15"></span>
            <span class="h-1.5 w-1.5 rounded-full bg-black/15"></span>
            <span class="h-1.5 w-1.5 rounded-full bg-black/15"></span>
          </div>

          <div class="relative min-h-0 flex-1 overflow-hidden">
            <img
              src="/images/projects/fmipa/new-home.png"
              alt="Redesigned FMIPA UGM homepage"
              loading="lazy"
              class="h-full w-full object-cover object-top"
            />
          </div>
        </div>


        <!-- Secondary page -->

        <div
          class="absolute right-[5%] top-[24%] h-[64%] w-[31%]
          overflow-hidden border border-white/15 bg-paper
          shadow-[0_20px_60px_rgba(0,0,0,0.20)]
          transition-transform duration-700 ease-out
          group-hover:-translate-y-4"
        >
          <img
            src="/images/projects/fmipa/new-iup.png"
            alt="Redesigned FMIPA UGM International Undergraduate Program page"
            loading="lazy"
            class="h-full w-full object-cover object-top"
          />
        </div>


        <!-- Bottom metadata -->

        <div
          class="absolute bottom-[4%] left-[4%]"
        >
          <p
            class="font-mono text-[8px] uppercase tracking-[0.1em] text-white/50"
          >
            UI/UX · IA · WordPress
          </p>
        </div>
      </div>
    )
  }


  <!-- =====================================================
       STUDENT MONITORING
       ===================================================== -->

  {
  project.preview === "monitoring" && (
    <div
      class="absolute inset-0 overflow-hidden bg-[#164B73]"
          >
      <!-- =================================================
          BACKGROUND DEPTH
          ================================================= -->

      <div
        class="absolute inset-0"
        style="
          background:
            radial-gradient(
              circle at 22% 28%,
              rgba(255,255,255,0.10),
              transparent 34%
            ),
            radial-gradient(
              circle at 82% 72%,
              rgba(5,28,47,0.24),
              transparent 40%
            );
        "
      ></div>

      <!-- =================================================
           TOP META
           ================================================= -->

      <div
        class="absolute inset-x-0 top-0 flex items-center justify-between px-[5%] py-[4%]"
      >
        <p
          class="font-mono text-[8px] uppercase tracking-[0.12em] text-white/65"
        >
          Student Monitoring / FMIPA UGM
        </p>

        <p
          class="font-mono text-[8px] uppercase tracking-[0.12em] text-white/65"
        >
          Production system · 2024
        </p>
      </div>


      <!-- =================================================
           MAIN SCREEN
           Dashboard Stats
           ================================================= -->

      <div
        class="absolute bottom-[8%] left-[6%] top-[15%] w-[67%]
        overflow-hidden border border-white/10 bg-white
        shadow-[0_24px_65px_rgba(7,25,40,0.28)]
        transition-transform duration-700 ease-out
        group-hover:-translate-y-2"
      >

        <img
          src="/images/projects/monitoring/dashboard-stats.png"
          alt="Student monitoring Dashboard Stats production interface"
          loading="lazy"
          class="h-full w-full object-cover object-left-top"
        />

      </div>


      <!-- =================================================
           SECONDARY SCREEN
           Actual monitoring table
           ================================================= -->

      <div
        class="absolute right-[5%] top-[29%] h-[54%] w-[43%]
        overflow-hidden border border-white/15 bg-white
        shadow-[0_20px_55px_rgba(7,25,40,0.30)]
        transition-transform duration-700 ease-out
        group-hover:-translate-y-4"
      >

        <img
          src="/images/projects/monitoring/role-dean-redacted.png"
          alt="Role-based troubled-student monitoring table"
          loading="lazy"
          class="h-full w-full object-cover object-left-top"
        />

      </div>


      <!-- =================================================
           NOTE
           ================================================= -->

      <div
        class="absolute bottom-[3%] left-[5%] flex items-center gap-3"
      >
        <span
          class="h-1.5 w-1.5 rounded-full bg-white/80"
        ></span>

        <p
          class="font-mono text-[7px] uppercase tracking-[0.09em] text-white/60"
        >
          Real production interface · sensitive values redacted
        </p>
      </div>

    </div>
    )
  }


  <!-- =====================================================
       REKMED
       ===================================================== -->

{
  project.preview === "datacakra" && (
    <div
      class="absolute inset-0 overflow-hidden bg-[#10B6C3]"
    >

      <!-- =================================================
           BACKGROUND
           ================================================= -->

      <div
        class="absolute inset-0"
        style="
          background:
            radial-gradient(
              circle at 18% 22%,
              rgba(255,255,255,0.22),
              transparent 34%
            ),
            radial-gradient(
              circle at 84% 76%,
              rgba(0,74,88,0.22),
              transparent 38%
            );
        "
      ></div>


      <!-- =================================================
           META
           ================================================= -->

      <div
        class="absolute inset-x-0 top-0 z-10 flex items-center justify-between px-[5%] py-[4%]"
      >
        <p
          class="font-mono text-[8px] uppercase tracking-[0.12em] text-white/75"
        >
          Datacakra / Product Design
        </p>

        <p
          class="font-mono text-[8px] uppercase tracking-[0.12em] text-white/75"
        >
          Internship · 2026
        </p>
      </div>


      <!-- =================================================
           MAIN MOCKUP
           ================================================= -->

      <div
        class="absolute bottom-[8%] left-[6%] top-[16%] w-[72%]
        overflow-hidden border border-white/30 bg-white
        shadow-[0_26px_70px_rgba(0,67,79,0.26)]
        transition-transform duration-700 ease-out
        group-hover:-translate-y-2"
      >
        <img
          src="/images/projects/datacakra/smart-building-dashboard.jpg"
          alt="Smart Building real-time monitoring dashboard concept designed for a Datacakra client proposal"
          loading="lazy"
          class="h-full w-full object-cover object-left-top"
        />
      </div>


      <!-- =================================================
           WORKSTREAM CARD
           ================================================= -->

      <div
        class="absolute bottom-[14%] right-[5%] z-10 w-[28%]
        border border-white/35 bg-white/95 p-[4%]
        shadow-[0_18px_45px_rgba(0,67,79,0.18)]"
      >

        <p
          class="font-mono text-[7px] uppercase tracking-[0.1em] text-[#137480]"
        >
          02 workstreams
        </p>


        <div class="mt-[12%]">

          <p
            class="text-[clamp(0.7rem,1vw,1rem)] font-medium tracking-[-0.025em] text-black"
          >
            Smart Building
          </p>

          <p
            class="mt-[4%] text-[7px] leading-[1.6] text-black/45"
          >
            Sales-facing dashboard concept
          </p>

        </div>


        <div
          class="my-[10%] border-t border-black/10"
        ></div>


        <div>

          <p
            class="text-[clamp(0.7rem,1vw,1rem)] font-medium tracking-[-0.025em] text-black"
          >
            RekMed × SATUSEHAT
          </p>

          <p
            class="mt-[4%] text-[7px] leading-[1.6] text-black/45"
          >
            Product and integration requirements
          </p>

        </div>

      </div>


      <!-- =================================================
           FOOTNOTE
           ================================================= -->

      <div
        class="absolute bottom-[3%] left-[5%] flex items-center gap-3"
      >
        <span
          class="h-1.5 w-1.5 rounded-full bg-white/85"
        ></span>

        <p
          class="font-mono text-[7px] uppercase tracking-[0.09em] text-white/70"
        >
          UI/UX · Product communication · Technical collaboration
        </p>
      </div>

    </div>
  )
}

</div>