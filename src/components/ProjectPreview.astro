---
import type { Project }
  from "../data/projects";

interface Props {
  project: Project;

  variant?:
    | "card"
    | "hero";
}

const {
  project,

  variant = "card",
} = Astro.props;

const frameClass =
  variant === "hero"
    ? "aspect-[16/9] md:aspect-[16/8]"
    : "aspect-[4/3]";
---

<div
  class:list={[
    "project-preview relative overflow-hidden",
    frameClass,
  ]}
>

  <!-- =====================================================
       FMIPA
       ===================================================== -->

  {
    project.preview === "fmipa" && (
      <div
        class="absolute inset-0 overflow-hidden bg-[#173d61]"
      >
        <!-- Background identity -->

        <div
          class="absolute inset-x-0 top-0 flex items-center justify-between px-[5%] py-[4%]"
        >
          <p
            class="font-mono text-[8px] uppercase tracking-[0.12em] text-white/50"
          >
            FMIPA UGM / Website Redesign
          </p>

          <p
            class="font-mono text-[8px] uppercase tracking-[0.12em] text-white/50"
          >
            2026
          </p>
        </div>


        <!-- Main browser-like composition -->

        <div
          class="absolute bottom-[-12%] left-[7%] top-[13%] w-[70%]
          flex-col overflow-hidden bg-paper shadow-[0_30px_80px_rgba(0,0,0,0.22)]
          transition-transform duration-700 ease-out
          group-hover:-translate-y-2"
        >
          <!-- browser bar -->

          <div
            class="flex h-[6%] items-center gap-1.5 border-b border-black/10 px-[3%]"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-black/15"></span>
            <span class="h-1.5 w-1.5 rounded-full bg-black/15"></span>
            <span class="h-1.5 w-1.5 rounded-full bg-black/15"></span>
          </div>

          <div class="relative min-h-0 flex-1 overflow-hidden">
            <img
              src="/images/projects/fmipa/new-home.png"
              alt="Redesigned FMIPA UGM homepage"
              loading="lazy"
              class="h-full w-full object-cover object-top"
            />
          </div>
        </div>


        <!-- Secondary page -->

        <div
          class="absolute right-[5%] top-[24%] h-[64%] w-[31%]
          overflow-hidden border border-white/15 bg-paper
          shadow-[0_20px_60px_rgba(0,0,0,0.20)]
          transition-transform duration-700 ease-out
          group-hover:-translate-y-4"
        >
          <img
            src="/images/projects/fmipa/new-iup.png"
            alt="Redesigned FMIPA UGM International Undergraduate Program page"
            loading="lazy"
            class="h-full w-full object-cover object-top"
          />
        </div>


        <!-- Bottom metadata -->

        <div
          class="absolute bottom-[4%] left-[4%]"
        >
          <p
            class="font-mono text-[8px] uppercase tracking-[0.1em] text-white/50"
          >
            UI/UX · IA · WordPress
          </p>
        </div>
      </div>
    )
  }


  <!-- =====================================================
       STUDENT MONITORING
       ===================================================== -->

  {
    project.preview === "monitoring" && (
      <div
        class="absolute inset-0 overflow-hidden bg-[#d7d8d2]"
      >
        <!-- Project number -->

        <span
          class="absolute right-[5%] top-[2%] font-mono text-[clamp(4rem,10vw,10rem)] leading-none tracking-[-0.08em] text-black/8"
        >
          02
        </span>


        <!-- Abstract software window -->

        <div
          class="absolute right-[10%] bottom-[10%] left-[7%] top-[12%] border border-black/10 bg-[#191a18] transition-transform duration-700 ease-out group-hover:-translate-y-2"
        >
          <!-- Header -->

          <div
            class="flex h-[11%] items-center border-b border-white/10 px-[4%]"
          >
            <span
              class="h-1.5 w-1.5 rounded-full bg-white/30"
            ></span>

            <span
              class="ml-3 font-mono text-[7px] uppercase tracking-[0.1em] text-white/35"
            >
              System / Dashboard
            </span>
          </div>


          <div
            class="grid h-[89%] grid-cols-[18%_1fr]"
          >
            <!-- Sidebar -->

            <div
              class="border-r border-white/10 p-[15%]"
            >
              <div
                class="h-1.5 w-[65%] bg-white/20"
              ></div>

              <div
                class="mt-[30%] space-y-[14%]"
              >
                <div
                  class="h-1 w-full bg-white/8"
                ></div>

                <div
                  class="h-1 w-[80%] bg-white/8"
                ></div>

                <div
                  class="h-1 w-[90%] bg-white/8"
                ></div>

                <div
                  class="h-1 w-[70%] bg-white/8"
                ></div>
              </div>
            </div>


            <!-- Content -->

            <div class="p-[5%]">
              <div
                class="flex items-end justify-between"
              >
                <div>
                  <div
                    class="h-1.5 w-12 bg-white/15"
                  ></div>

                  <div
                    class="mt-2 h-4 w-28 bg-white/65"
                  ></div>
                </div>

                <div
                  class="h-5 w-12 border border-white/15"
                ></div>
              </div>

              <div
                class="mt-[7%] grid grid-cols-3 gap-[3%]"
              >
                {
                  [1, 2, 3].map(() => (
                    <div
                      class="aspect-[3/2] border border-white/8 bg-white/[0.03] p-[8%]"
                    >
                      <div
                        class="h-1 w-[50%] bg-white/15"
                      ></div>

                      <div
                        class="mt-[15%] h-5 w-[38%] bg-white/55"
                      ></div>
                    </div>
                  ))
                }
              </div>

              <div
                class="mt-[5%] h-[30%] border border-white/8 bg-white/[0.02]"
              ></div>
            </div>
          </div>
        </div>


        <div
          class="absolute bottom-[5%] left-[5%] font-mono text-[8px] uppercase tracking-[0.12em] text-black/40"
        >
          Temporary project preview
        </div>
      </div>
    )
  }


  <!-- =====================================================
       REKMED
       ===================================================== -->

  {
    project.preview === "rekmed" && (
      <div
        class="absolute inset-0 overflow-hidden bg-[#e0e5df]"
      >
        <!-- Vertical title -->

        <p
          class="absolute top-[8%] left-[5%] font-mono text-[8px] uppercase tracking-[0.14em] text-black/40"
        >
          Product concept / 2026
        </p>


        <!-- Back sheet -->

        <div
          class="absolute left-[18%] top-[20%] h-[63%] w-[60%] border border-black/10 bg-[#bdc9c0] transition-transform duration-700 ease-out group-hover:-translate-x-2"
        ></div>


        <!-- Front sheet -->

        <div
          class="absolute bottom-[9%] right-[8%] h-[63%] w-[60%] bg-[#f6f5f0] p-[6%] transition-transform duration-700 ease-out group-hover:-translate-y-2"
        >
          <div
            class="flex items-center justify-between"
          >
            <span
              class="font-mono text-[7px] uppercase tracking-[0.1em] text-black/35"
            >
              RekMed
            </span>

            <span
              class="h-2 w-2 rounded-full bg-[#83998b]"
            ></span>
          </div>

          <div class="mt-[16%]">
            <div
              class="h-2 w-[20%] bg-black/12"
            ></div>

            <div
              class="mt-[4%] h-5 w-[78%] bg-black/75"
            ></div>

            <div
              class="mt-[2%] h-5 w-[55%] bg-black/75"
            ></div>
          </div>

          <div
            class="mt-[14%] grid grid-cols-2 gap-[5%]"
          >
            <div
              class="aspect-[4/3] border border-black/8"
            ></div>

            <div
              class="aspect-[4/3] bg-black/[0.04]"
            ></div>
          </div>
        </div>


        <!-- Big lettering -->

        <span
          class="absolute bottom-[2%] left-[4%] text-[clamp(3rem,7vw,7rem)] leading-none font-medium tracking-[-0.07em] text-black/8"
        >
          RM
        </span>


        <div
          class="absolute right-[5%] top-[5%] font-mono text-[8px] uppercase tracking-[0.12em] text-black/35"
        >
          Temporary project preview
        </div>
      </div>
    )
  }

</div>