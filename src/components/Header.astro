---
import { site } from "../data/site";

const pathname = Astro.url.pathname;

const navItems = [
  {
    label: "Work",
    href: "/work/",
  },
  {
    label: "About",
    href: "/about/",
  },
];

const isActive = (href: string) => {
  return pathname.startsWith(href);
};
---

<header
  class="sticky top-0 z-50 bg-paper/90 backdrop-blur-md"
>
  <div class="site-container">
    <div
      class="flex h-[72px] items-center justify-between border-b border-line"
    >
      <a
        href="/"
        aria-label={`${site.name} — Home`}
        class="group flex items-center gap-3"
      >
        <span
          class="relative flex h-2 w-2"
          aria-hidden="true"
        >
          <span
            class="absolute inline-flex h-full w-full rounded-full bg-ink opacity-0 transition-all duration-500 group-hover:scale-[2.2] group-hover:opacity-10"
          ></span>

          <span
            class="relative inline-flex h-2 w-2 rounded-full bg-ink"
          ></span>
        </span>

        <span
          class="text-[13px] font-semibold tracking-[-0.02em] md:text-[14px]"
        >
          <span class="hidden sm:inline">
            {site.name}
          </span>

          <span class="sm:hidden">
            {site.shortName}
          </span>
        </span>
      </a>

      <nav
        aria-label="Primary navigation"
        class="flex items-center gap-5 text-[13px] md:gap-8 md:text-[14px]"
      >
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={
                isActive(item.href)
                  ? "page"
                  : undefined
              }
              class:list={[
                "text-link transition-opacity",
                {
                  "font-semibold":
                    isActive(item.href),
                },
              ]}
            >
              {item.label}
            </a>
          ))
        }

        <a
          href={`mailto:${site.email}`}
          class="text-link"
        >
          Contact
        </a>
      </nav>
    </div>
  </div>
</header>
