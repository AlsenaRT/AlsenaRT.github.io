---
const pathname = Astro.url.pathname;

const navItems = [
  {
    label: "Work",
    href: "/work/",
  },
  {
    label: "About",
    href: "/about/",
  },
];

const isActive = (href: string) => {
  if (href === "/") {
    return pathname === "/";
  }

  return pathname.startsWith(href);
};
---

<header class="relative z-50">
  <div
    class="site-container flex h-[88px] items-center justify-between"
  >
    <a
      href="/"
      class="text-[14px] font-semibold tracking-[-0.02em]"
      aria-label="Alif Rafi Tulusena — Home"
    >
      ALIF RAFI T.
    </a>

    <nav
      aria-label="Primary navigation"
      class="flex items-center gap-6 text-[14px] md:gap-8"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "transition-opacity duration-200 hover:opacity-50",
              {
                "font-semibold": isActive(item.href),
              },
            ]}
          >
            {item.label}
          </a>
        ))
      }

      <a
        href="mailto:alifrafitulusena@gmail.com"
        class="transition-opacity duration-200 hover:opacity-50"
      >
        Contact
      </a>
    </nav>
  </div>
</header>