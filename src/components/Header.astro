---
const pathname = Astro.url.pathname;

const navItems = [
  {
    label: "Work",
    href: "/work/",
  },
  {
    label: "About",
    href: "/about/",
  },
];

const isActive = (href: string) => {
  return pathname.startsWith(href);
};
---

<header
  class="sticky top-0 z-50 bg-paper/90 backdrop-blur-md"
>
  <div class="site-container">
    <div
      class="flex h-[72px] items-center justify-between border-b border-line"
    >
      <!-- Identity -->

      <a
        href="/"
        aria-label="Alif Rafi Tulusena — Home"
        class="group flex items-center gap-3"
      >
        <span
          class="h-2 w-2 rounded-full bg-ink transition-transform duration-300 group-hover:scale-150"
          aria-hidden="true"
        ></span>

        <span
          class="text-[13px] font-semibold tracking-[-0.02em]"
        >
          <span class="hidden sm:inline">
            Alif Rafi Tulusena
          </span>

          <span class="sm:hidden">
            Alif Rafi
          </span>
        </span>
      </a>


      <!-- Navigation -->

      <nav
        aria-label="Primary navigation"
        class="flex items-center gap-5 text-[13px] md:gap-8"
      >
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={
                isActive(item.href)
                  ? "page"
                  : undefined
              }
              class:list={[
                "text-link transition-opacity",
                {
                  "font-semibold":
                    isActive(item.href),
                },
              ]}
            >
              {item.label}
            </a>
          ))
        }

        <a
          href="mailto:alifrafitulusena@gmail.com"
          class="text-link"
        >
          Contact
        </a>
      </nav>
    </div>
  </div>
</header>