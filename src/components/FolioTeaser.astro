---
import {
  folio,
} from "../data/folio";

const pages =
  folio.pages.slice(0, 4);
---

<section
  class="site-container my-28 md:my-48"
>
  <div
    class="bg-ink px-6 py-10 text-paper sm:px-10 md:px-14 md:py-16 lg:px-20 lg:py-20"
  >
    <!-- Intro -->

    <div
      class="grid gap-12 md:grid-cols-12"
    >
      <div
        class="md:col-span-3"
      >
        <p
          class="rule-label text-accent"
        >
          Design Folio
        </p>
      </div>


      <div
        class="md:col-span-8 md:col-start-5"
      >
        <h2
          class="max-w-[900px] text-[clamp(2.8rem,5.5vw,6.1rem)] leading-[0.96] font-medium tracking-[-0.05em]"
        >
          A different way to
          <span
            class="editorial-serif"
          >
            read the work.
          </span>
        </h2>


        <p
          class="mt-8 max-w-xl text-[14px] leading-[1.8] text-paper/55"
        >
          The website separates projects into case
          studies. The folio keeps selected design
          work together as one visual sequence.
        </p>
      </div>
    </div>


    <!-- Publication preview -->

    <div
      class="mt-16 grid items-start gap-5 md:mt-24 md:grid-cols-12"
    >

      <!-- Main spread -->

      {
        pages[0] && (
          <figure
            class="md:col-span-6"
          >
            <div
              class="bg-white"
            >
              <img
                src={pages[0].image}
                alt={pages[0].alt}
                loading="lazy"
                class="block h-auto w-full"
              />
            </div>

            <figcaption
              class="mt-3 flex justify-between border-t border-paper/20 pt-3 text-[9px] uppercase tracking-[0.08em] text-paper/40"
            >
              <span>
                Design Portfolio
              </span>

              <span>
                {pages[0].number}
              </span>
            </figcaption>
          </figure>
        )
      }


      {
        pages[1] && (
          <figure
            class="md:col-span-6 md:mt-16"
          >
            <div
              class="bg-white"
            >
              <img
                src={pages[1].image}
                alt={pages[1].alt}
                loading="lazy"
                class="block h-auto w-full"
              />
            </div>

            <figcaption
              class="mt-3 flex justify-between border-t border-paper/20 pt-3 text-[9px] uppercase tracking-[0.08em] text-paper/40"
            >
              <span>
                Selected page
              </span>

              <span>
                {pages[1].number}
              </span>
            </figcaption>
          </figure>
        )
      }


      {
        pages[2] && (
          <figure
            class="md:col-span-4 md:col-start-3 md:mt-10"
          >
            <div
              class="bg-white"
            >
              <img
                src={pages[2].image}
                alt={pages[2].alt}
                loading="lazy"
                class="block h-auto w-full"
              />
            </div>

            <figcaption
              class="mt-3 text-right text-[9px] text-paper/35"
            >
              {pages[2].number}
            </figcaption>
          </figure>
        )
      }


      {
        pages[3] && (
          <figure
            class="md:col-span-4 md:col-start-8 md:mt-24"
          >
            <div
              class="bg-white"
            >
              <img
                src={pages[3].image}
                alt={pages[3].alt}
                loading="lazy"
                class="block h-auto w-full"
              />
            </div>

            <figcaption
              class="mt-3 text-right text-[9px] text-paper/35"
            >
              {pages[3].number}
            </figcaption>
          </figure>
        )
      }

    </div>


    <!-- Actions -->

    <div
      class="mt-16 flex flex-col gap-6 border-t border-paper/20 pt-7 sm:flex-row sm:items-center sm:justify-between"
    >
      <p
        class="max-w-md text-[12px] leading-[1.7] text-paper/45"
      >
        Selected pages are available directly on
        the site. The complete publication is also
        available as a PDF.
      </p>


      <div
        class="flex flex-wrap gap-7 text-[13px]"
      >
        <a
          href="/folio/"
          class="border-b border-paper/40 pb-1"
        >
          Explore folio →
        </a>

        <a
          href={folio.pdf}
          target="_blank"
          rel="noopener noreferrer"
          class="border-b border-paper/25 pb-1 text-paper/55 transition-colors hover:text-paper"
        >
          Open PDF ↗
        </a>
      </div>
    </div>
  </div>
</section>