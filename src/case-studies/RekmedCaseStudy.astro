---
import type {
  Project,
} from "../data/projects";


interface Props {
  project: Project;
}


const {
  project,
} = Astro.props;

const productAreas = [
  {
    number: "01",
    title: "Patient Flow",
    description:
      "Queues, registration, patient selection, referrals, and examination status.",
  },
  {
    number: "02",
    title: "Medical Record",
    description:
      "Baseline data, complaints, examination, diagnoses, prescriptions, and SOAP.",
  },
  {
    number: "03",
    title: "Management",
    description:
      "Accounts, patients, clinics, doctors, pharmacy, treatments, and supporting data.",
  },
  {
    number: "04",
    title: "Reporting",
    description:
      "Medical-record outputs and other operational reports produced by the system.",
  },
];


const requirementLayers = [
  {
    number: "01",
    label: "Patient identity",
    title:
      "Different people required different identity flows.",
    items: [
      "WNI → NIK",
      "WNA → Passport / KITAS",
      "Newborn → NIK or mother's NIK + birth order",
      "WNI without NIK → alternative identity fields",
    ],
  },
  {
    number: "02",
    label: "Visit conditions",
    title:
      "Queue and visit type changed what information was needed.",
    items: [
      "General / BPJS",
      "New visit / referral",
      "Sick visit / healthy visit",
      "Referral number and BPJS status where relevant",
    ],
  },
  {
    number: "03",
    label: "Clinical information",
    title:
      "Existing RekMed fields needed to align with structured clinical information.",
    items: [
      "Conditions → ICD-10",
      "Procedures → ICD-9-CM",
      "Medication → KFA / DTO references",
      "Allergies → structured terminology",
      "Specimen and diagnostic-report information",
    ],
  },
  {
    number: "04",
    label: "Interface behaviour",
    title:
      "Some integration requirements also implied new UI behaviour.",
    items: [
      "Conditional domicile / KTP address fields",
      "Polyclinic filtering after BPJS queue selection",
      "Remaining-queue information",
      "iCare access when BPJS is connected",
      "BPJS treatment and DPHO medication actions",
    ],
  },
];


const fieldSemantics = [
  {
    label: "Numeric",
    value: "Integer / decimal",
  },
  {
    label: "Measurement",
    value: "bpm · g · g/dL · mg/dL",
  },
  {
    label: "Binary state",
    value: "Boolean / Yes-No",
  },
  {
    label: "Controlled option",
    value: "Enum-like clinical states",
  },
];


const owned = [
  "Smart Building dashboard mockup",
  "RekMed product survey",
  "Information-architecture mapping",
  "Field and workflow requirement mapping",
  "Design communication with my supervisor",
];


const notOwned = [
  "SATUSEHAT API implementation",
  "Backend integration",
  "Existing RekMed interface design",
  "Later implementation after my involvement ended",
];
---

<!-- =======================================================
     DATACAKRA PROJECT OPENING
     Two-workstream language
     ======================================================= -->

<section
  class="site-container pt-10 md:pt-16"
>
  <!-- Identity -->

  <div
    class="page-title-wrap md:col-span-8"
  >
    <div
      class="md:col-span-8"
    >
      <p
        class="rule-label text-accent"
      >
        UI/UX Internship / 2026
      </p>

      <h1
        class="page-title mt-10 text-[clamp(2.5rem,10.5vw,8rem)] leading-[0.92] font-medium tracking-[-0.05em] md:max-w-[1100px] md:leading-[0.9] md:tracking-[-0.055em]"
      >
        Datacakra Product Design
        <span
          class="editorial-serif block md:ml-[0.14em] md:inline"
        >
          Internship.
        </span>
      </h1>
    </div>

    <div
      class="min-w-0 flex items-end md:col-span-3 md:col-start-10"
    >
      <p
        class="max-w-[320px] text-[14px] leading-[1.8] text-muted"
      >
        One internship, two very different assignments:
        a sales-facing interface concept and a deeper
        investigation into an existing healthcare
        product.
      </p>
    </div>
  </div>


  <!-- Two workstreams -->

  <div
    class="mt-14 grid gap-3 border-y border-ink py-3 md:mt-20 md:grid-cols-2"
  >

    <!-- Workstream A -->

    <article
      class="flex min-h-[600px] flex-col bg-[#0d8e99] p-6 text-white md:p-8 lg:p-10"
    >
      <div
        class="flex items-center justify-between text-[9px] uppercase tracking-[0.08em] text-white/60"
      >
        <p>
          01 / External
        </p>

        <p>
          Sales communication
        </p>
      </div>

      <div
        class="mt-10"
      >
        <p
          class="text-[clamp(2.4rem,4vw,4.8rem)] leading-[0.96] font-medium tracking-[-0.045em]"
        >
          Smart Building
        </p>

        <p
          class="mt-4 max-w-[420px] text-[13px] leading-[1.7] text-white/70"
        >
          A dashboard concept produced for a
          partnership and product proposal.
        </p>
      </div>

      <div
        class="mt-auto pt-14"
      >
        <div
          class="overflow-hidden bg-white"
        >
          <img
            src="/images/projects/datacakra/smart-building-dashboard.jpg"
            alt="Smart Building monitoring dashboard designed during the Datacakra internship"
            loading="eager"
            class="block h-auto w-full"
          />
        </div>
      </div>
    </article>


    <!-- Workstream B -->

    <article
      class="flex min-h-[600px] flex-col bg-ink p-6 text-paper md:p-8 lg:p-10"
    >
      <div
        class="flex items-center justify-between text-[9px] uppercase tracking-[0.08em] text-paper/50"
      >
        <p>
          02 / Internal
        </p>

        <p>
          Product investigation
        </p>
      </div>

      <div
        class="mt-10"
      >
        <p
          class="text-[clamp(2.4rem,4vw,4.8rem)] leading-[0.96] font-medium tracking-[-0.045em]"
        >
          RekMed × SATUSEHAT
        </p>

        <p
          class="mt-4 max-w-[440px] text-[13px] leading-[1.7] text-paper/60"
        >
          Product survey, information-architecture
          mapping, and requirements support around
          an existing electronic medical record
          platform.
        </p>
      </div>

      <div
        class="mt-auto pt-14"
      >
        <div
          class="overflow-hidden bg-white p-2 md:p-3"
        >
          <img
            src="/images/projects/datacakra/rekmed-information-architecture.png"
            alt="RekMed information architecture mapping"
            loading="eager"
            class="block h-auto w-full"
          />
        </div>
      </div>
    </article>
  </div>


  <!-- Framing statement -->

  <div
    class="grid gap-8 py-14 md:grid-cols-12 md:py-20"
  >
    <div
      class="md:col-span-3"
    >
      <p
        class="rule-label text-muted"
      >
        Internship structure
      </p>
    </div>

    <div
      class="md:col-span-8 md:col-start-5"
    >
      <p
        class="max-w-[940px] text-[clamp(2rem,4vw,4.5rem)] leading-[1.04] font-medium tracking-[-0.04em]"
      >
        The work moved between designing something
        that could communicate an idea quickly and
        studying an existing system carefully enough
        to help other people
        <span
          class="editorial-serif"
        >
          build the next part of it.
        </span>
      </p>
    </div>
  </div>
</section>

<!-- =======================================================
     01 / INTERNSHIP CONTEXT
     ======================================================= -->

<section
  class="site-container py-20 md:py-32"
>
  <div
    class="grid gap-12 md:grid-cols-12"
  >
    <div
      class="md:col-span-3"
    >
      <p
        class="rule-label text-muted"
      >
        01 / The internship
      </p>
    </div>


    <div
      class="md:col-span-8 md:col-start-5"
    >
      <h2
        class="max-w-[960px] text-[clamp(2.6rem,5vw,5.8rem)] leading-[0.98] font-medium tracking-[-0.05em]"
      >
        The two assignments required almost
        opposite ways of working.
      </h2>


      <div
        class="mt-10 grid gap-8 md:grid-cols-2"
      >
        <p
          class="text-[15px] leading-[1.8] text-muted"
        >
          I joined Datacakra as the only UI/UX Design
          intern in a cross-functional internship
          batch. My direct design team consisted of
          myself and a company UI/UX Designer who
          supervised my work.
        </p>

        <p
          class="text-[15px] leading-[1.8] text-muted"
        >
          Smart Building asked me to move quickly from
          a brief into a presentation-ready interface.
          RekMed asked me to slow down, inspect an
          existing product, and understand what its
          interface and data were already doing.
        </p>
      </div>


      <div
        class="mt-14 border-y border-ink"
      >
        <div
          class="grid md:grid-cols-2"
        >
          <div
            class="border-b border-line py-7 md:border-r md:border-b-0 md:pr-8"
          >
            <p
              class="text-[10px] uppercase tracking-[0.08em] text-accent"
            >
              External-facing
            </p>

            <p
              class="mt-4 text-[clamp(1.7rem,2.6vw,2.8rem)] leading-[1.05] font-medium tracking-[-0.035em]"
            >
              Communicate an idea quickly.
            </p>
          </div>


          <div
            class="py-7 md:pl-8"
          >
            <p
              class="text-[10px] uppercase tracking-[0.08em] text-muted"
            >
              Internal-facing
            </p>

            <p
              class="mt-4 text-[clamp(1.7rem,2.6vw,2.8rem)] leading-[1.05] font-medium tracking-[-0.035em]"
            >
              Understand an existing system carefully.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =======================================================
     WORKSTREAM A / SMART BUILDING
     ======================================================= -->

<section
  class="bg-[#0d8e99] text-white"
>
  <div
    class="site-container py-16 md:py-24"
  >
    <div
      class="grid gap-10 md:grid-cols-12"
    >
      <div
        class="md:col-span-3"
      >
        <p
          class="rule-label text-white/60"
        >
          Workstream A
        </p>
      </div>


      <div
        class="md:col-span-8 md:col-start-5"
      >
        <p
          class="text-[10px] uppercase tracking-[0.08em] text-white/55"
        >
          Smart Building Proposal
        </p>

        <h2
          class="mt-7 max-w-[980px] text-[clamp(3rem,6vw,6.5rem)] leading-[0.94] font-medium tracking-[-0.055em]"
        >
          Turn technical capability
          into something a client can see.
        </h2>
      </div>
    </div>
  </div>
</section>

<section
  class="site-container py-20 md:py-32"
>
  <div
    class="grid gap-12 md:grid-cols-12"
  >
    <div
      class="md:col-span-3"
    >
      <p
        class="rule-label text-muted"
      >
        02 / Smart Building
      </p>
    </div>


    <div
      class="md:col-span-8 md:col-start-5"
    >
      <h2
        class="max-w-[930px] text-[clamp(2.4rem,4.5vw,5rem)] leading-[1] font-medium tracking-[-0.045em]"
      >
        The brief already had a direction.
        My job was to make it convincing.
      </h2>


      <div
        class="mt-10 grid gap-8 md:grid-cols-2"
      >
        <p
          class="text-[14px] leading-[1.8] text-muted"
        >
          The proposal described a centralized
          Smart Building environment covering CCTV
          analytics, alerts, energy monitoring,
          reporting, and device supervision.
        </p>

        <p
          class="text-[14px] leading-[1.8] text-muted"
        >
          I was not designing the entire product or
          pitch deck from zero. My supervisor had
          already explored a visual direction, and
          I extended that language into a dashboard
          mockup that could be used directly in the
          proposal.
        </p>
      </div>
    </div>
  </div>


  <!-- Constraints -->

  <div
    class="mt-16 grid border-y border-ink md:grid-cols-3 md:mt-24"
  >

    <div
      class="border-b border-line py-8 md:border-r md:border-b-0 md:pr-8"
    >
      <p
        class="text-[10px] uppercase tracking-[0.08em] text-muted"
      >
        Time
      </p>

      <p
        class="mt-5 text-[clamp(2rem,3vw,3.5rem)] font-medium tracking-[-0.045em]"
      >
        ~3 hours
      </p>

      <p
        class="mt-4 max-w-sm text-[13px] leading-[1.7] text-muted"
      >
        The mockup was completed within one short
        working session.
      </p>
    </div>


    <div
      class="border-b border-line py-8 md:border-r md:border-b-0 md:px-8"
    >
      <p
        class="text-[10px] uppercase tracking-[0.08em] text-muted"
      >
        Direction
      </p>

      <p
        class="mt-5 text-[clamp(2rem,3vw,3.5rem)] font-medium tracking-[-0.045em]"
      >
        Existing
      </p>

      <p
        class="mt-4 max-w-sm text-[13px] leading-[1.7] text-muted"
      >
        The dashboard extended an established
        proposal language rather than creating an
        unrelated new design system.
      </p>
    </div>


    <div
      class="py-8 md:pl-8"
    >
      <p
        class="text-[10px] uppercase tracking-[0.08em] text-muted"
      >
        Review
      </p>

      <p
        class="mt-5 text-[clamp(2rem,3vw,3.5rem)] font-medium tracking-[-0.045em]"
      >
        01
      </p>

      <p
        class="mt-4 max-w-sm text-[13px] leading-[1.7] text-muted"
      >
        One review focused mainly on using empty
        space better and strengthening typography
        hierarchy.
      </p>
    </div>

  </div>
</section>

<!-- =======================================================
     SMART BUILDING / FINAL MOCKUP
     ======================================================= -->

<section
  class="site-container pb-24 md:pb-40"
>
  <figure>
    <div
      class="bg-[#0d8e99] p-4 sm:p-6 md:p-10 lg:p-14"
    >
      <div
        class="overflow-hidden bg-white"
      >
        <img
          src="/images/projects/datacakra/smart-building-dashboard.jpg"
          alt="Smart Building real-time monitoring dashboard mockup"
          loading="lazy"
          class="block h-auto w-full"
        />
      </div>
    </div>


    <figcaption
      class="grid gap-5 border-t border-line pt-4 text-[10px] uppercase tracking-[0.07em] text-muted md:grid-cols-3"
    >
      <p>
        Final dashboard mockup
      </p>

      <p class="md:text-center">
        CCTV monitoring
      </p>

      <p class="md:text-right">
        Proposal communication
      </p>
    </figcaption>
  </figure>


  <div
    class="mt-12 grid gap-10 md:grid-cols-12"
  >
    <div
      class="md:col-span-3"
    >
      <p
        class="text-[10px] uppercase tracking-[0.08em] text-muted"
      >
        Design emphasis
      </p>
    </div>


    <div
      class="md:col-span-8 md:col-start-5"
    >
      <div
        class="border-t border-line"
      >

        <div
          class="grid gap-5 border-b border-line py-6 md:grid-cols-12"
        >
          <span
            class="text-[10px] text-accent md:col-span-1"
          >
            01
          </span>

          <h3
            class="text-xl font-medium tracking-[-0.03em] md:col-span-4"
          >
            Immediate supervision
          </h3>

          <p
            class="max-w-lg text-[13px] leading-[1.7] text-muted md:col-span-6"
          >
            A large camera grid makes centralized
            real-time monitoring understandable
            almost immediately.
          </p>
        </div>


        <div
          class="grid gap-5 border-b border-line py-6 md:grid-cols-12"
        >
          <span
            class="text-[10px] text-accent md:col-span-1"
          >
            02
          </span>

          <h3
            class="text-xl font-medium tracking-[-0.03em] md:col-span-4"
          >
            Visible system state
          </h3>

          <p
            class="max-w-lg text-[13px] leading-[1.7] text-muted md:col-span-6"
          >
            Device summaries and camera-health
            information communicate that the screen
            is monitoring infrastructure, not simply
            displaying video.
          </p>
        </div>


        <div
          class="grid gap-5 border-b border-line py-6 md:grid-cols-12"
        >
          <span
            class="text-[10px] text-accent md:col-span-1"
          >
            03
          </span>

          <h3
            class="text-xl font-medium tracking-[-0.03em] md:col-span-4"
          >
            Incidents in context
          </h3>

          <p
            class="max-w-lg text-[13px] leading-[1.7] text-muted md:col-span-6"
          >
            Alert activity sits close to the
            monitoring view so capabilities such as
            intrusion, crowd, and loitering detection
            can be understood as part of one system.
          </p>
        </div>

      </div>


      <p
        class="mt-10 max-w-2xl text-[14px] leading-[1.8] text-muted"
      >
        The final mockup was incorporated into the
        proposal deck used for a partnership and
        product pitch. My involvement ended before
        the later proposal outcome.
      </p>
    </div>
  </div>
</section>

<!-- =======================================================
     WORKSTREAM B / REKMED
     ======================================================= -->

<section
  class="bg-ink text-paper"
>
  <div
    class="site-container py-20 md:py-32 lg:py-40"
  >
    <div
      class="grid gap-12 md:grid-cols-12"
    >
      <div
        class="md:col-span-3"
      >
        <p
          class="rule-label text-accent"
        >
          Workstream B
        </p>
      </div>


      <div
        class="md:col-span-8 md:col-start-5"
      >
        <p
          class="text-[10px] uppercase tracking-[0.08em] text-paper/45"
        >
          RekMed × SATUSEHAT
        </p>

        <h2
          class="mt-7 max-w-[980px] text-[clamp(3rem,6vw,6.5rem)] leading-[0.94] font-medium tracking-[-0.055em]"
        >
          Before changing the product,
          I had to understand what was
          already there.
        </h2>

        <p
          class="mt-10 max-w-2xl text-[14px] leading-[1.8] text-paper/55"
        >
          Unlike the Smart Building task, this work
          was not primarily about visual interface
          design. I was working inward from an
          existing electronic medical record product
          to understand its pages, actions, data, and
          integration requirements.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- =======================================================
     03 / PRODUCT SURVEY
     ======================================================= -->

<section
  class="site-container py-20 md:py-32"
>
  <div
    class="grid gap-12 md:grid-cols-12"
  >
    <div
      class="md:col-span-3"
    >
      <p
        class="rule-label text-muted"
      >
        03 / Product survey
      </p>
    </div>


    <div
      class="md:col-span-8 md:col-start-5"
    >
      <h2
        class="max-w-[950px] text-[clamp(2.6rem,5vw,5.8rem)] leading-[0.98] font-medium tracking-[-0.05em]"
      >
        I mapped the product before mapping
        the integration.
      </h2>

      <div
        class="mt-10 grid gap-8 md:grid-cols-2"
      >
        <p
          class="text-[14px] leading-[1.8] text-muted"
        >
          I studied the existing RekMed guidebook,
          explored the development version of the
          application, and documented what pages
          existed and what users could do within them.
        </p>

        <p
          class="text-[14px] leading-[1.8] text-muted"
        >
          This gave me a working model of where
          patient information entered the product,
          which actions changed medical information,
          and where integration requirements would
          intersect with the current interface.
        </p>
      </div>
    </div>
  </div>


  <!-- Product areas -->

  <div
    class="mt-16 border-t border-ink md:mt-24"
  >
    {
      productAreas.map(
        (area) => (
          <div
            class="grid gap-5 border-b border-line py-7 md:grid-cols-12"
          >
            <p
              class="text-[10px] text-accent md:col-span-1"
            >
              {area.number}
            </p>

            <h3
              class="text-[clamp(1.6rem,2.4vw,2.6rem)] leading-[1.05] font-medium tracking-[-0.035em] md:col-span-4"
            >
              {area.title}
            </h3>

            <p
              class="max-w-xl text-[14px] leading-[1.75] text-muted md:col-span-6 md:col-start-7"
            >
              {area.description}
            </p>
          </div>
        )
      )
    }
  </div>
</section>

<!-- =======================================================
     INFORMATION ARCHITECTURE
     ======================================================= -->

<section
  class="site-container pb-24 md:pb-40"
>
  <div
    class="grid gap-12 border-t border-ink pt-10 md:grid-cols-12"
  >
    <div
      class="md:col-span-3"
    >
      <p
        class="rule-label text-muted"
      >
        Information architecture
      </p>
    </div>


    <div
      class="md:col-span-8 md:col-start-5"
    >
      <h2
        class="max-w-[900px] text-[clamp(2.4rem,4.5vw,5rem)] leading-[1] font-medium tracking-[-0.045em]"
      >
        Pages, features, and actions became
        one map.
      </h2>

      <p
        class="mt-8 max-w-2xl text-[14px] leading-[1.8] text-muted"
      >
        The map separates destinations, functionality,
        and user actions so the existing product could
        be discussed in more concrete terms before
        integration requirements were layered onto it.
      </p>
    </div>
  </div>


  <figure
    class="mt-14 md:mt-20"
  >
    <div
      class="border border-line bg-white p-2 md:p-4"
    >
      <img
        src="/images/projects/datacakra/rekmed-information-architecture.png"
        alt="RekMed information architecture mapping pages, features, and actions"
        loading="lazy"
        class="block h-auto w-full"
      />
    </div>


    <figcaption
      class="grid gap-6 border-t border-line pt-5 md:grid-cols-3"
    >
      <div>
        <p
          class="text-[10px] uppercase tracking-[0.08em]"
        >
          Yellow
        </p>

        <p
          class="mt-2 text-[12px] text-muted"
        >
          Page or major destination.
        </p>
      </div>


      <div>
        <p
          class="text-[10px] uppercase tracking-[0.08em]"
        >
          Orange
        </p>

        <p
          class="mt-2 text-[12px] text-muted"
        >
          Feature available inside a page.
        </p>
      </div>


      <div>
        <p
          class="text-[10px] uppercase tracking-[0.08em]"
        >
          Pink
        </p>

        <p
          class="mt-2 text-[12px] text-muted"
        >
          User action or control tied to a feature.
        </p>
      </div>
    </figcaption>
  </figure>
</section>

<!-- =======================================================
