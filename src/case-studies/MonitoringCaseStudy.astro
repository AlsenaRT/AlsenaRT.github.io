---
import type {
  Project,
} from "../data/projects";

interface Props {
  project: Project;
}

const {
  project,
} = Astro.props;

const degreeFlows = [
  {
    number: "03.1",
    degree: "S1",
    title: "Undergraduate monitoring",
    src: "/images/projects/monitoring/flowchart-s1.png",
    alt: "S1 undergraduate student monitoring flowchart",
    milestones: ["KKN", "Proposal examination", "Thesis examination"],
    description:
      "The undergraduate flow evaluates mandatory milestones in sequence and uses separate reminder and overdue-warning windows before adding a student to the monitoring list.",
  },
  {
    number: "03.2",
    degree: "S2",
    title: "Master’s monitoring",
    src: "/images/projects/monitoring/flowchart-s2.png",
    alt: "S2 master's student monitoring flowchart",
    milestones: ["Proposal examination", "Thesis seminar", "Thesis examination"],
    description:
      "The master’s flow follows a different progression and timeline, so its academic checkpoints are evaluated independently from the undergraduate rules.",
  },
  {
    number: "03.3",
    degree: "S3",
    title: "Doctoral monitoring",
    src: "/images/projects/monitoring/flowchart-s3.png",
    alt: "S3 doctoral student monitoring flowchart",
    milestones: ["Comprehensive examination", "Assessment", "UTUP"],
    description:
      "The doctoral flow uses its own mandatory agenda sequence and reminder logic, demonstrating why one generic rule could not represent all degree levels.",
  },
];

const roleViews = [
  {
    title: "Dean / Faculty",
    scope: "Faculty-wide access",
    src: "/images/projects/monitoring/role-dean-redacted.png",
    alt: "Dean role view of the production student monitoring system",
    description:
      "Faculty leadership can review troubled-student records across the faculty rather than being restricted to one program or department.",
  },
  {
    title: "Department Head",
    scope: "Department-level access",
    src: "/images/projects/monitoring/role-department-head-redacted.png",
    alt: "Department head role view of the production student monitoring system",
    description:
      "Department leadership receives the same monitoring structure with the dataset restricted to programs inside its department.",
  },
  {
    title: "Program Head",
    scope: "Study-program access",
    src: "/images/projects/monitoring/role-program-head-redacted.png",
    alt: "Program head role view of the production student monitoring system",
    description:
      "Program heads and secretaries only receive monitoring data for students within their own study program.",
  },
  {
    title: "Supervisor / Promoter",
    scope: "Supervised students only",
    src: "/images/projects/monitoring/role-supervisor-redacted.png",
    alt: "Academic supervisor role view of the production student monitoring system",
    description:
      "Academic supervisors and promoter teams see only students assigned to them, keeping the same feature useful without exposing unrelated records.",
  },
];

const testResults = [
  ["Login system", "Valid"],
  ["Dean filtering", "Valid"],
  ["Department filtering", "Valid"],
  ["Program filtering", "Valid"],
  ["Supervisor filtering", "Valid"],
  ["Dashboard Stats", "Valid"],
  ["Pagination", "Valid"],
  ["Email notification", "Valid"],
  ["Excel export", "Troubleshoot"],
];

const dataSources = [
  {
    name: "api_khs_raw",
    role:
      "Course-history and academic records used to reconstruct completed academic activity.",
  },
  {
    name: "api_bimbingan_raw",
    role:
      "Student-to-supervisor relationships used to determine academic responsibility.",
  },
  {
    name: "pegawais",
    role:
      "Employee data used to resolve lecturers and supervisor identities.",
  },
  {
    name: "users",
    role:
      "Persuratan accounts used as part of authentication and access handling.",
  },
  {
    name: "probstud_prodi",
    role:
      "Program-level troubled-student totals used by Dashboard Stats.",
  },
];


const operationalFeatures = [
  {
    number: "01",
    title: "Pagination & sorting",
    description:
      "Large result sets are divided into manageable pages, while compatible fields can be sorted for faster review.",
  },
  {
    number: "02",
    title: "Two-stage notification",
    description:
      "Students and their supervisor or promoter receive a reminder before the deadline and a stronger warning if the milestone becomes overdue.",
  },
  {
    number: "03",
    title: "Excel reporting",
    description:
      "Detailed monitoring data can be exported for administrative follow-up using PHPSpreadsheet.",
  },
];
---

<!-- =======================================================
     MONITORING PROJECT OPENING
     Systems / data language
     ======================================================= -->

<section
  class="mt-8 bg-ink text-paper md:mt-12"
>
  <div
    class="site-container py-10 md:py-16 lg:py-20"
  >
    <!-- Header -->

    <div
      class="grid gap-12 md:grid-cols-12"
    >
      <div
        class="md:col-span-8"
      >
        <p
          class="rule-label text-accent"
        >
          Academic Monitoring System
        </p>

        <h1
          class="mt-10 max-w-[1100px] text-[clamp(3.5rem,7vw,8rem)] leading-[0.9] font-medium tracking-[-0.055em]"
        >
          Student Performance
          <br />
          Monitoring System
        </h1>
      </div>


      <!-- System metrics -->

      <div
        class="grid grid-cols-2 gap-px bg-paper/20 md:col-span-4"
      >
        <div
          class="bg-ink p-5 md:p-6"
        >
          <p
            class="text-[9px] uppercase tracking-[0.08em] text-paper/50"
          >
            Records
          </p>

          <p
            class="mt-4 text-[clamp(1.8rem,3vw,3.5rem)] tracking-[-0.04em]"
          >
            ~1,500
          </p>

          <p
            class="mt-2 text-[11px] text-paper/50"
          >
            student records
          </p>
        </div>

        <div
          class="bg-ink p-5 md:p-6"
        >
          <p
            class="text-[9px] uppercase tracking-[0.08em] text-paper/50"
          >
            Degree logic
          </p>

          <p
            class="mt-4 text-[clamp(1.8rem,3vw,3.5rem)] tracking-[-0.04em]"
          >
            03
          </p>

          <p
            class="mt-2 text-[11px] text-paper/50"
          >
            S1 · S2 · S3
          </p>
        </div>

        <div
          class="bg-ink p-5 md:p-6"
        >
          <p
            class="text-[9px] uppercase tracking-[0.08em] text-paper/50"
          >
            Data scopes
          </p>

          <p
            class="mt-4 text-[clamp(1.8rem,3vw,3.5rem)] tracking-[-0.04em]"
          >
            04
          </p>

          <p
            class="mt-2 text-[11px] text-paper/50"
          >
            access levels
          </p>
        </div>

        <div
          class="bg-ink p-5 md:p-6"
        >
          <p
            class="text-[9px] uppercase tracking-[0.08em] text-paper/50"
          >
            Validation
          </p>

          <p
            class="mt-4 text-[clamp(1.8rem,3vw,3.5rem)] tracking-[-0.04em]"
          >
            09
          </p>

          <p
            class="mt-2 text-[11px] text-paper/50"
          >
            test scenarios
          </p>
        </div>
      </div>
    </div>


    <!-- Dashboard -->

    <div
      class="mt-14 border-t border-paper/20 pt-7 md:mt-20 md:pt-10"
    >
      <div
        class="grid gap-8 md:grid-cols-12"
      >
        <div
          class="md:col-span-9"
        >
          <div
            class="relative isolate aspect-[16/9] overflow-hidden bg-[#171817]"
          >
            <img
              src={project.cover}
              alt={project.coverAlt}
              class="absolute inset-0 h-full w-full object-cover"
              style={`
                object-position:
                  ${project.coverPosition ?? "100% 30%"};

                transform:
                  scale(${project.coverScale ?? 1});
              `}
            />
          </div>
        </div>


        <div
          class="flex flex-col justify-between md:col-span-3"
        >
          <p
            class="max-w-[320px] text-[14px] leading-[1.75] text-paper/60"
          >
            An internal module that turns academic
            policy, student records, milestone status,
            organizational roles, and notification
            history into one operational monitoring
            workflow.
          </p>

          <div
            class="mt-10 border-t border-paper/20 pt-5"
          >
            <p
              class="text-[9px] uppercase tracking-[0.08em] text-paper/40"
            >
              Stack
            </p>

            <p
              class="mt-3 text-[12px] leading-[1.8] text-paper/70"
            >
              PHP · CodeIgniter 4
              <br />
              MySQL · JavaScript
              <br />
              HTML · CSS
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =======================================================
     01 / FROM POLICY TO SYSTEM
     ======================================================= -->

<section
  class="site-container py-20 md:py-32"
>
  <div
    class="grid gap-12 md:grid-cols-12"
  >
    <div
      class="md:col-span-3"
    >
      <p
        class="rule-label text-muted"
      >
        01 / The problem
      </p>
    </div>


    <div
      class="md:col-span-8 md:col-start-5"
    >
      <h2
        class="max-w-[950px] text-[clamp(2.6rem,5vw,5.8rem)] leading-[0.98] font-medium tracking-[-0.05em]"
      >
        Academic policy had to become
        something the system could actually evaluate.
      </h2>

      <div
        class="mt-10 grid gap-8 md:grid-cols-2"
      >
        <p
          class="text-[15px] leading-[1.8] text-muted"
        >
          Before the module existed, identifying
          students who were late completing mandatory
          academic milestones depended heavily on
          manual review. That made early detection
          slower and easier to overlook.
        </p>

        <p
          class="text-[15px] leading-[1.8] text-muted"
        >
          The feature therefore had to do more than
          display records. It needed to understand
          academic timing, completed milestones,
          supervisor relationships, organizational
          responsibility, and previous notification
          state.
        </p>
      </div>
    </div>
  </div>


  <!-- Translation strip -->

  <div
    class="mt-16 border-y border-ink md:mt-24"
  >
    <div
      class="grid md:grid-cols-4"
    >

      <div
        class="border-b border-line py-7 md:border-r md:border-b-0 md:px-7 md:first:pl-0"
      >
        <p
          class="text-[10px] uppercase tracking-[0.08em] text-accent"
        >
          Input
        </p>

        <p
          class="mt-4 text-xl font-medium tracking-[-0.025em]"
        >
          Academic policy
        </p>
      </div>


      <div
        class="border-b border-line py-7 md:border-r md:border-b-0 md:px-7"
      >
        <p
          class="text-[10px] uppercase tracking-[0.08em] text-muted"
        >
          Translate
        </p>

        <p
          class="mt-4 text-xl font-medium tracking-[-0.025em]"
        >
          Monitoring rules
        </p>
      </div>


      <div
        class="border-b border-line py-7 md:border-r md:border-b-0 md:px-7"
      >
        <p
          class="text-[10px] uppercase tracking-[0.08em] text-muted"
        >
          Evaluate
        </p>

        <p
          class="mt-4 text-xl font-medium tracking-[-0.025em]"
        >
          Student records
        </p>
      </div>


      <div
        class="py-7 md:px-7 md:last:pr-0"
      >
        <p
          class="text-[10px] uppercase tracking-[0.08em] text-muted"
        >
          Output
        </p>

        <p
          class="mt-4 text-xl font-medium tracking-[-0.025em]"
        >
          Actionable cases
        </p>
      </div>

    </div>
  </div>
</section>

<!-- =======================================================
     EARLY PROTOTYPE
     ======================================================= -->

<section
  class="site-container pb-24 md:pb-40"
>
  <div
    class="grid items-start gap-10 border-t border-line pt-8 md:grid-cols-12"
  >
    <div
      class="md:col-span-4"
    >
      <p
        class="text-[10px] uppercase tracking-[0.08em] text-muted"
      >
        Early prototype
      </p>

      <h3
        class="mt-6 max-w-sm text-[clamp(1.8rem,3vw,3.3rem)] leading-[1.02] font-medium tracking-[-0.04em]"
      >
        The interface started as a way to discuss
        the rules.
      </h3>

      <p
        class="mt-6 max-w-sm text-[14px] leading-[1.75] text-muted"
      >
        The first prototype was used with the project
        initiator, academic staff, and technical
        mentors to make the proposed monitoring
        workflow concrete before development moved
        further into the existing Persuratan system.
      </p>
    </div>


    <figure
      class="md:col-span-7 md:col-start-6"
    >
      <div
        class="bg-[#e3dfd5] p-4 sm:p-6 md:p-8"
      >
        <img
          src="/images/projects/monitoring/early-prototype.png"
          alt="Early prototype of the student monitoring dashboard"
          loading="lazy"
          class="block h-auto w-full"
        />
      </div>

      <figcaption
        class="mt-4 border-t border-line pt-3 text-[11px] leading-[1.65] text-muted"
      >
        Early dashboard prototype used to validate
        the direction before production implementation.
      </figcaption>
    </figure>
  </div>
</section>

<!-- =======================================================
     02 / DEGREE LOGIC
     ======================================================= -->

<section
  class="bg-ink text-paper"
>
  <div
    class="site-container py-20 md:py-32 lg:py-40"
  >
    <div
      class="grid gap-12 md:grid-cols-12"
    >
      <div
        class="md:col-span-3"
      >
        <p
          class="rule-label text-accent"
        >
          02 / Detection logic
        </p>
      </div>


      <div
        class="md:col-span-8 md:col-start-5"
      >
        <h2
          class="max-w-[980px] text-[clamp(2.8rem,5.5vw,6rem)] leading-[0.97] font-medium tracking-[-0.055em]"
        >
          One rule could not represent
          three different academic pathways.
        </h2>

        <p
          class="mt-10 max-w-2xl text-[15px] leading-[1.8] text-paper/55"
        >
          Undergraduate, master's, and doctoral
          students follow different milestone
          sequences and timelines. Each degree level
          therefore required its own detection flow
          rather than being forced into a generic rule.
        </p>
      </div>
    </div>


    <!-- Degree flows -->

    <div
      class="mt-20 border-t border-paper/25"
    >
      {
        degreeFlows.map(
          (flow, index) => (
            <article
              class="grid gap-10 border-b border-paper/15 py-12 md:grid-cols-12 md:py-16"
            >
              <!-- Identity -->

              <div
                class="md:col-span-2"
              >
                <p
                  class="text-[10px] uppercase tracking-[0.08em] text-accent"
                >
                  {flow.number}
                </p>

                <p
                  class="mt-4 text-[clamp(2.5rem,4vw,4.8rem)] leading-none font-medium tracking-[-0.05em]"
                >
                  {flow.degree}
                </p>
              </div>


              <!-- Flowchart -->

              <div
                class:list={[
                  "md:col-span-5",
                  index % 2 === 1 &&
                    "md:order-3",
                ]}
              >
                <div
                  class="bg-[#161816] p-4 md:p-6"
                >
                  <img
                    src={flow.src}
                    alt={flow.alt}
                    loading="lazy"
                    class="mx-auto block h-auto w-full"
                  />
                </div>
              </div>


              <!-- Explanation -->

              <div
                class:list={[
                  "md:col-span-5",
                  index % 2 === 1 &&
                    "md:order-2",
                ]}
              >
                <h3
                  class="max-w-lg text-[clamp(1.8rem,2.8vw,3.2rem)] leading-[1.03] font-medium tracking-[-0.04em]"
                >
                  {flow.title}
                </h3>

                <p
                  class="mt-6 max-w-lg text-[13px] leading-[1.8] text-paper/55"
                >
                  {flow.description}
                </p>


                <div
                  class="mt-8 border-t border-paper/20"
                >
                  {
                    flow.milestones.map(
                      (
                        milestone,
                        milestoneIndex
                      ) => (
                        <div
                          class="grid grid-cols-[40px_1fr] gap-4 border-b border-paper/15 py-4"
                        >
                          <span
                            class="text-[9px] text-paper/35"
                          >
                            {String(
                              milestoneIndex +
                                1
                            ).padStart(
                              2,
                              "0"
                            )}
                          </span>

                          <span
                            class="text-[12px] text-paper/70"
                          >
                            {milestone}
                          </span>
                        </div>
                      )
                    )
                  }
                </div>
              </div>
            </article>
          )
        )
      }
    </div>
  </div>
</section>

<!-- =======================================================
     03 / DATA ARCHITECTURE
     ======================================================= -->

<section
  class="site-container py-24 md:py-40"
>
  <div
    class="grid gap-12 md:grid-cols-12"
  >
    <div
      class="md:col-span-3"
    >
      <p
        class="rule-label text-muted"
      >
        03 / Under the interface
      </p>
    </div>


    <div
      class="md:col-span-8 md:col-start-5"
    >
      <h2
        class="max-w-[960px] text-[clamp(2.7rem,5vw,5.8rem)] leading-[0.98] font-medium tracking-[-0.05em]"
      >
        The dashboard only works because several
        disconnected records are reconstructed
        underneath it.
      </h2>

      <p
        class="mt-10 max-w-2xl text-[15px] leading-[1.8] text-muted"
      >
        The information required by the monitoring
        feature did not exist as one clean dataset.
        Student activity, supervisor relationships,
        employee information, accounts, monitoring
        parameters, and program statistics had to be
        connected and processed before the interface
        could show a reliable result.
      </p>
    </div>
  </div>


  <!-- Architecture schematic -->

  <div
    class="mt-16 border-y border-ink md:mt-24"
  >

    <div
      class="grid md:grid-cols-[1fr_auto_1fr_auto_1fr]"
    >

      <!-- Sources -->

      <div
        class="py-8 md:pr-8"
      >
        <p
          class="text-[10px] uppercase tracking-[0.08em] text-accent"
        >
          01 / Existing data
        </p>

        <h3
          class="mt-5 text-2xl font-medium tracking-[-0.035em]"
        >
          MySQL sources
        </h3>

        <p
          class="mt-4 max-w-sm text-[13px] leading-[1.7] text-muted"
        >
          Academic records and existing Persuratan
          data.
        </p>
      </div>


      <div
        class="hidden items-center px-4 text-muted md:flex"
        aria-hidden="true"
      >
        →
      </div>


      <!-- Processing -->

      <div
        class="border-t border-line py-8 md:border-t-0 md:border-l md:border-r md:px-8"
      >
        <p
          class="text-[10px] uppercase tracking-[0.08em] text-muted"
        >
          02 / Application
        </p>

        <h3
          class="mt-5 text-2xl font-medium tracking-[-0.035em]"
        >
          CodeIgniter 4
        </h3>

        <p
          class="mt-4 max-w-sm text-[13px] leading-[1.7] text-muted"
        >
          PHP, MVC logic, filtering, monitoring
          parameters, notification state, and
          reporting.
        </p>
      </div>


      <div
        class="hidden items-center px-4 text-muted md:flex"
        aria-hidden="true"
      >
        →
      </div>


      <!-- Output -->

      <div
        class="border-t border-line py-8 md:border-t-0 md:pl-8"
      >
        <p
          class="text-[10px] uppercase tracking-[0.08em] text-muted"
        >
          03 / Interface
        </p>

        <h3
          class="mt-5 text-2xl font-medium tracking-[-0.035em]"
        >
          Monitoring views
        </h3>

        <p
          class="mt-4 max-w-sm text-[13px] leading-[1.7] text-muted"
        >
          Dashboard statistics, student records,
          role-specific datasets, alerts, and export.
        </p>
      </div>

    </div>
  </div>


  <!-- Data sources -->

  <div
    class="mt-14 grid gap-8 md:grid-cols-12"
  >
    <div
      class="md:col-span-3"
    >
      <p
        class="text-[10px] uppercase tracking-[0.08em] text-muted"
      >
        Existing sources
      </p>
    </div>


    <div
      class="md:col-span-8 md:col-start-5"
    >
      <div
        class="border-t border-line"
      >
        {
          dataSources.map(
            (
              source,
              index
            ) => (
              <div
                class="grid gap-4 border-b border-line py-5 md:grid-cols-[56px_180px_1fr]"
              >
                <span
                  class="text-[9px] text-muted"
                >
                  {String(
                    index + 1
                  ).padStart(
                    2,
                    "0"
                  )}
                </span>

                <code
                  class="font-mono text-[11px]"
                >
                  {source.name}
                </code>

                <p
                  class="max-w-xl text-[12px] leading-[1.7] text-muted"
                >
                  {source.role}
                </p>
              </div>
            )
          )
        }
      </div>
    </div>
  </div>
</section>

<!-- =======================================================
     04 / PRODUCTION INTERFACE
     ======================================================= -->

<section
  class="site-container pb-24 md:pb-40"
>
  <div
    class="grid gap-12 border-t border-ink pt-10 md:grid-cols-12"
  >
    <div
      class="md:col-span-3"
    >
      <p
        class="rule-label text-muted"
      >
        04 / Production
      </p>
    </div>


    <div
      class="md:col-span-8 md:col-start-5"
    >
      <h2
        class="max-w-[930px] text-[clamp(2.7rem,5vw,5.8rem)] leading-[0.98] font-medium tracking-[-0.05em]"
      >
        The interface is deliberately quieter
        than the system behind it.
      </h2>

      <p
        class="mt-10 max-w-2xl text-[15px] leading-[1.8] text-muted"
      >
        The module lives inside an existing
        administrative application, so the production
        UI was designed to remain familiar rather
        than introducing a completely separate visual
        language.
      </p>
    </div>
  </div>


  <!-- Main production view -->

  <figure
    class="mt-16 md:mt-24"
  >
    <div
      class="relative isolate aspect-[16/9] overflow-hidden bg-[#ddd9cf]"
    >
      <img
        src={project.cover}
        alt={project.coverAlt}
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover"
        style={`
          object-position:
            ${project.coverPosition ?? "50% 50%"};

          transform:
            scale(${project.coverScale ?? 1});
        `}
      />
    </div>

    <figcaption
      class="grid gap-4 border-t border-line pt-4 text-[10px] uppercase tracking-[0.07em] text-muted md:grid-cols-3"
    >
      <p>
        Production interface
      </p>

      <p class="md:text-center">
        Persuratan FMIPA
      </p>

      <p class="md:text-right">
        PHP · CodeIgniter 4 · MySQL
      </p>
    </figcaption>
  </figure>
</section>

<!-- =======================================================
     05 / ACCESS SCOPES
     ======================================================= -->

<section
  class="bg-[#dedad0]"
>
  <div
    class="site-container py-20 md:py-32"
  >
    <div
      class="grid gap-12 md:grid-cols-12"
    >
      <div
        class="md:col-span-3"
      >
