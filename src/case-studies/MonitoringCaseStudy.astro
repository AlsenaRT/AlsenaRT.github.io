            <p class="font-mono text-[9px] uppercase tracking-[0.08em] text-white/40">View</p>
            <h3 class="mt-4 text-2xl font-medium tracking-[-0.04em]">Frontend</h3>
            <p class="mt-4 text-[13px] leading-[1.7] text-white/55">HTML · CSS · JavaScript</p>
          </div>

          <div class="hidden items-center text-white/25 lg:flex">→</div>

          <div class="border border-white/10 p-6">
            <p class="font-mono text-[9px] uppercase tracking-[0.08em] text-white/40">Controller / Model</p>
            <h3 class="mt-4 text-2xl font-medium tracking-[-0.04em]">CodeIgniter 4</h3>
            <p class="mt-4 text-[13px] leading-[1.7] text-white/55">PHP · MVC · application logic</p>
          </div>

          <div class="hidden items-center text-white/25 lg:flex">→</div>

          <div class="border border-white/10 p-6">
            <p class="font-mono text-[9px] uppercase tracking-[0.08em] text-white/40">Data</p>
            <h3 class="mt-4 text-2xl font-medium tracking-[-0.04em]">MySQL</h3>
            <p class="mt-4 text-[13px] leading-[1.7] text-white/55">Academic records · parameters · notification logs</p>
